import React, { useState, useEffect } from "react";
import { makeStyles } from "@mui/styles";
import Dialog from "@mui/material/Dialog";
import { Input } from "../../../../components/genericComponents/Input";
import MasterEnvDropdown from "../../../../components/genericComponents/MasterEnvDropdown";
import GenerateURL from "../../../../util/APIUrlProvider";
import properties from "../../../../properties/properties";
import InvokeApi, { PostData } from "../../../../util/apiInvoker";
import { useCustomSnackbar } from "../../../../contexts/SnackbarContext";
import { VALIDATION_TYPE_REQUIRED, ValidateDataSet } from "../../../../util/Validator";
import { showErrorHandlerUpdated } from "../../../../util/util";
import Button from "../../../../components/genericComponents/Button";
import GenericSkeleton from "../../../../components/genericComponents/Skeletons/GenericSkeleton";

const AddVirtualMachineDialog = ({
  open = true,
  handleSuccess,
  handleClose,
  editData = null
}) => {
  const classes = useStyles();
  const { showSnackbar } = useCustomSnackbar();
  const [isOpen, setIsOpen] = useState(open);
  const localStorageKey = "vm_group_creation_info_flag";
  const hideInfoSection = JSON.parse(localStorage.getItem(localStorageKey));

  const [state, setState] = useState({
    showLeftPanel: true,
    isLoading: false,
    isSaving: false,
    isEditMode: false,
    dontShowAgain: false,
    data: {},
    error: {},
    master_envs_list: [],
    selectedMasterEnv: [],
    env_data_loading: false,
  });

  useEffect(() => {
    setIsOpen(open);
  }, [open]);

  useEffect(() => {
    if (open) {
      fetchMasterEnvList();
    }
  }, [open]);

  useEffect(() => {
    if (open) {
      if (editData) {
        setState(prev => ({ ...prev, isEditMode: true }));
        fetchVMGroupDetails(editData.id || editData);
      } else {
        resetForm();
      }
    }
  }, [open, editData]);

  useEffect(() => {
    if (
      state.master_envs_list.length > 0 &&
      state.data.environment_master_type &&
      Array.isArray(state.data.environment_master_type)
    ) {
      const envIds = state.data.environment_master_type.map(id => String(id));

      const filteredEnvs = state.master_envs_list.filter((item) =>
        envIds.includes(String(item.order))
      );

      const currentIds = state.selectedMasterEnv.map(env => env.order).sort();
      const newIds = filteredEnvs.map(env => env.order).sort();
      const isDifferent = JSON.stringify(currentIds) !== JSON.stringify(newIds);

      if (isDifferent && filteredEnvs.length > 0) {
        console.log("Updating selectedMasterEnv from useEffect:", filteredEnvs);
        setState((prev) => ({
          ...prev,
          selectedMasterEnv: filteredEnvs,
        }));
      }
    }
  }, [state.master_envs_list, state.data.environment_master_type]);

  const resetForm = () => {
    setState((prev) => ({
      ...prev,
      showLeftPanel: !hideInfoSection,
      isLoading: false,
      dontShowAgain: !!hideInfoSection,
      data: {},
      error: {},
      selectedMasterEnv: [],
      isEditMode: false,
    }));
  };

  const fetchVMGroupDetails = (vmGroupId) => {
    setState((prev) => ({ ...prev, isLoading: true }));

    const requestInfo = {
      endPoint: GenerateURL({ edit_id: vmGroupId }, properties.api.edit_vm_group),
      httpMethod: "GET",
      httpHeaders: { "Content-Type": "application/json" },
    };

    InvokeApi(
      requestInfo,
      fetchVMGroupDetailsSuccess,
      fetchVMGroupDetailsFailed
    );
  };

  const fetchVMGroupDetailsSuccess = (data) => {
    let environmentIds = [];
    if (data.env_obj && Array.isArray(data.env_obj)) {
      environmentIds = data.env_obj.map(env => env.id);
    } else if (data.environment_master_type && Array.isArray(data.environment_master_type)) {
      environmentIds = data.environment_master_type;
    }

    const newData = {
      virtual_group_name: data.virtual_group_name || '',
      environment_master_type: environmentIds,
    };


    if (state.master_envs_list.length > 0 && environmentIds.length > 0) {

      const envIdsStrings = environmentIds.map(id => String(id));

      const filteredEnvs = state.master_envs_list.filter((item) =>
        envIdsStrings.includes(String(item.order))
      );

      setState((prev) => ({
        ...prev,
        showLeftPanel: !hideInfoSection,
        isLoading: false,
        dontShowAgain: !!hideInfoSection,
        data: newData,
        error: {},
        selectedMasterEnv: filteredEnvs,
      }));
    } else {
      setState((prev) => ({
        ...prev,
        showLeftPanel: !hideInfoSection,
        isLoading: false,
        dontShowAgain: !!hideInfoSection,
        data: newData,
        error: {},
      }));
    }
  };

  const fetchVMGroupDetailsFailed = (error) => {
    showSnackbar("error", "Failed to fetch VM group details", error?.message);
    setState((prev) => ({
      ...prev,
      isLoading: false,
      error: error || {},
    }));
  };

  function fetchMasterEnvList() {
    setState((prev) => ({ ...prev, env_data_loading: true }));

    const requestInfo = {
      endPoint: GenerateURL({}, properties.api.master_envs),
      httpMethod: "GET",
      httpHeaders: { "Content-Type": "application/json" },
    };

    InvokeApi(
      requestInfo,
      fetchMasterEnvListDataSuccess,
      fetchMasterEnvListDataFailed
    );
  }

  function fetchMasterEnvListDataSuccess(data) {
    setState((prev) => ({
      ...prev,
      master_envs_list: data.map((item) => ({
        tabName: item.name,
        order: item.id,
      })),
      env_data_loading: false,
    }));
  }

  function fetchMasterEnvListDataFailed(error) {
    showSnackbar("error", "Failed to fetch environments", error?.message);
    setState((prev) => ({
      ...prev,
      error: error,
      env_data_loading: false,
    }));
  }

  const updateMasterEnv = (master_env_order) => {
    let filter_current_env = state.master_envs_list.find(
      (item) => item.order === master_env_order
    );

    if (filter_current_env) {
      setState((prev) => {
        const isAlreadySelected = prev.selectedMasterEnv.some(
          (env) => env.order === master_env_order
        );

        if (!isAlreadySelected) {
          return {
            ...prev,
            selectedMasterEnv: [...prev.selectedMasterEnv, filter_current_env],
            error: { ...prev.error, selectedMasterEnv: "" },
          };
        }
        return prev;
      });
    }
  };

  const removeMasterEnv = (order) => {
    setState((prev) => ({
      ...prev,
      selectedMasterEnv: prev.selectedMasterEnv.filter(
        (env) => env.order !== order
      ),
    }));
  };

  const updateSelectedMasterEnv = (data) => {
    console.log(data, "updateSelectedMasterEnv");
  };

  const onChangeHandler = (e) => {
    const { name, value } = e.target;
    setState((prev) => ({
      ...prev,
      data: {
        ...prev.data,
        [name]: value,
      },
      error: {
        ...prev.error,
        [name]: "",
      },
    }));
  };

  const validateAndSave = () => {
    const validations = {
      virtual_group_name: [VALIDATION_TYPE_REQUIRED],
    };

    const result = ValidateDataSet(state.data, validations);

    if (!state.selectedMasterEnv || state.selectedMasterEnv.length === 0) {
      result.valid = false;
      result.error = {
        ...result.error,
        selectedMasterEnv: "Please select at least one environment",
      };
    }

    if (result.valid) {
      const post_data = {
        virtual_group_name: state.data.virtual_group_name?.trim(),
        environment_master_type: state.selectedMasterEnv.map(
          (item) => item.order
        ),
      };

      const isEdit = editData !== null;

      const temp_url = isEdit
        ? GenerateURL({ edit_id: editData.id || editData }, properties.api.edit_vm_group)
        : GenerateURL({}, properties.api.create_vm_group);


      setState((prev) => ({ ...prev, isSaving: true }));
      const loadingMsg = isEdit ? "Updating VM Group..." : "Creating VM Group...";
      showSnackbar("info", loadingMsg);


      PostData(temp_url, post_data, saveSuccess, saveFail);
    } else {
      let error_msg = showErrorHandlerUpdated({ ...result.error });
      const errorMsg = editData ? "Unable to update VM group." : "Unable to create VM group.";
      showSnackbar("error", errorMsg, error_msg);
      setState((prev) => ({
        ...prev,
        error: result.error,
        isSaving: false,
      }));
    }
  };

  function saveSuccess(response) {
    const isEdit = editData !== null;
    const successMsg = isEdit ? "VM group updated successfully." : "VM group created successfully.";
    const detailMsg = isEdit ? "Changes have been saved." : "Please continue with add VM";

    showSnackbar("success", successMsg, detailMsg);
    setState((prev) => ({
      ...prev,
      isSaving: false,
    }));

    if (handleSuccess) {
      handleSuccess(response);
    }

    closeDialog();
  }

  function saveFail(response) {
    const isEdit = editData !== null;
    let error_msg = showErrorHandlerUpdated(response);
    const errorMsg = isEdit ? "Unable to update VM group." : "Unable to create VM group.";
    showSnackbar("error", errorMsg, error_msg);

    const errorObj = typeof response === 'string'
      ? { general: response }
      : (response || {});

    setState((prev) => ({
      ...prev,
      isSaving: false,
      error: {
        ...prev.error,
        ...errorObj,
      },
    }));
  }

  const handleCloseLeftStrip = () => {
    if (state.dontShowAgain) {
      localStorage.setItem(localStorageKey, JSON.stringify(true));
    }
    setState((prev) => ({
      ...prev,
      showLeftPanel: false,
    }));
  };

  const handleDontShowCheckbox = (e) => {
    const value = e?.target?.type === "checkbox" ? e.target.checked : e;
    setState((prev) => ({ ...prev, dontShowAgain: value }));
  };

  const closeDialog = () => {
    // resetForm(); 
    setIsOpen(false);
    if (handleClose) handleClose();
  };

  const dialogTitle = state.isEditMode ? "Edit Virtual Machine Group" : "Add Virtual Machine Group";

  return (
    <Dialog
      fullWidth={true}
      maxWidth={"md"}
      open={isOpen}
      onClose={closeDialog}
      className={`${classes.root} dialog-align-corner`}
      aria-labelledby="max-width-dialog-title"
    >
      <div
        className="d-grid ml-auto dialog-sub-component"
        style={{
          gridTemplateColumns: state.showLeftPanel
            ? "396px 650px"
            : "0px 650px",
        }}
      >
        {!hideInfoSection && (
          <div
            className={
              state.showLeftPanel
                ? "left-panel-dialog bg-white position-relative"
                : "left-panel-dialog-down"
            }

          >
            <div
              className={
                "d-flex align-center space-between left-panel-header pd-10"
              }
              style={{ padding: "11px 20px" }}
            >
              <p>INFORMATION</p>
              <button
                className="btn btn-icon-only"
                onClick={handleCloseLeftStrip}
              >
                <span className="ri-close-line color-icon-secondary"></span>
              </button>
            </div>
            <div className="pd-10" style={{ padding: "16px 20px" }}>
              <p className="font-16 font-weight-600 color-primary mb-10">
                What are VM Groups?
              </p>
              <ul class="font-weight-400 font-12 text-grey-40 pl-20">
                
                  A VM Group is a logical collection of virtual machines that are managed together as a single entity. This allows you to apply configurations, scaling rules, and deployment pipelines to a set of VMs rather than managing each one individually.
                 <br/>
                  Key Functionalities
                <li>
                  Unified Management: Organize VMs based on their purpose (e.g., "Database Cluster," "Legacy Auth Service," or "Department-specific VMs") for quick access and bulk actions.
                </li>

                <li>
                   Seamless Hybrid Orchestration:VM Groups unify modern and legacy infrastructure by enabling a single CI/CD pipeline to build and deploy both microservices (Kubernetes) and non-microservices (VMs). This "Single Pane of Glass" management eliminates fragmented tooling and dissolves "Ops Silos," ensuring consistent delivery across the entire stack.
                </li>

                <li>
                  Placement Constraints: VM Groups help optimize performance by ensuring resource-heavy VMs aren't all placed on the same physical host, or improving fault tolerance by spreading them across clusters.
                </li>
              </ul>




            </div>
            <div
              className="checkbox-only-divi"
              style={{ padding: "10px 20px" }}
            >
              <Input
                style={{}}
                type="simple-checkbox"
                name="dont_show_again"
                label="Don't show this again"
                data={{ dont_show_again: state.dontShowAgain }}
                value={state.dontShowAgain}
                error={state.error}
                onChangeHandler={handleDontShowCheckbox}
              />
            </div>
          </div>
        )}

        <div className="right-panel-dialog bg-white">
          <div
            className="font-18 font-weight-600 color-white d-flex align-center space-between"
            style={{ backgroundColor: "#0086ff", padding: "16px 16px" }}
          >
            <p>{dialogTitle}</p>
            <button
              className="btn float-cancel-button "
              style={
                hideInfoSection || !state.showLeftPanel
                  ? {
                    position: "absolute",
                    top: "0px",
                    height:"58px",
                    width:"54px",
                    left: "-55px",
                    zIndex: 1000,
                  }
                  : {
                    position: "absolute",
                    top: "0px",
                    height:"58px",
                    width:"54px",
                    left: "-450px",
                    zIndex: 1000,
                  }
              }
              onClick={closeDialog}
            >
              <span className="ri-close-line "></span>
            </button>
          </div>

          <div
            style={{
              padding: "0 20px 120px 20px",
              overflowY: "auto",
            }}
          >
            <div className={classes.formContainer}>
              <div className={classes.formGroup}>
                {state.isLoading && state.isEditMode ? (
                  <>
                    <GenericSkeleton
                      variant={"rect"}
                      width={"40%"}
                      height={"16px"}
                      style={{ borderRadius: "4px", marginBottom: "8px" }}
                      rootStyle={{ flex: 'none' }}
                    />
                    <GenericSkeleton
                      variant={"rect"}
                      width={"100%"}
                      height={"46px"}
                      style={{ borderRadius: "4px" }}
                      rootStyle={{ flex: 'none' }}
                    />
                  </>
                ) : (
                  <Input
                    type="text"
                    label="Virtual Machine Group Name"
                    placeholder="Enter Name"
                    name="virtual_group_name"
                    mandatorySign
                    data={state.data}
                    error={state.error}
                    info={
                      "In Buildpiper, for a monolithic application, you can onboard a single VM or a group of VMs, referred to as a VM Group."
                    }
                    onChangeHandler={onChangeHandler}
                    style={{ height: "46px" }}
                  />
                )}
              </div>

              <div className={classes.formGroup}>
                {state.isLoading && state.isEditMode ? (
                  <>
                    <GenericSkeleton
                      variant={"rect"}
                      width={"40%"}
                      height={"16px"}
                      style={{ borderRadius: "4px", marginBottom: "8px" }}
                      rootStyle={{ flex: 'none' }}
                    />
                    <GenericSkeleton
                      variant={"rect"}
                      width={"100%"}
                      height={"46px"}
                      style={{ borderRadius: "4px" }}
                      rootStyle={{ flex: 'none' }}
                    />
                  </>
                ) : (
                  <>
                    <MasterEnvDropdown
                      envTabList={[]}
                      selectedMasterEnv={state.selectedMasterEnv}
                      selectedEnvTab={state.selected_env_master_id}
                      envChangeHandler={updateSelectedMasterEnv}
                      masterEnvList={state.master_envs_list}
                      selectedComponentEnv={state.selected_component_env_taborder}
                      masterEnvChangeHandler={updateMasterEnv}
                      removeFromList={removeMasterEnv}
                      error={state?.error?.selectedMasterEnv ? true : false}
                      style={{ marginTop: "5px" }}
                    />
                    {state?.error?.selectedMasterEnv && (
                      <p className="error-message">
                        {state.error.selectedMasterEnv}
                      </p>
                    )}
                  </>
                )}
              </div>
            </div>
          </div>

          <div className="footer-right-panel d-flex align-center justify-end ">
            <Button className="font-weight-600 font-12" variant="ghost" onClick={closeDialog}>
              CANCEL
            </Button>
            <Button
              className="btn btn-primary"
              isLoading={state.isSaving}
              onClick={validateAndSave}
            >
              {state.isEditMode ? "UPDATE" : "SAVE & CONTINUE"}
            </Button>
          </div>
        </div>
      </div>
    </Dialog>
  );
};

const useStyles = makeStyles((theme) => ({
  root: {
    "&.dialog-align-corner": {
      "& .MuiPaper-root": {
        maxWidth: "1100px",
