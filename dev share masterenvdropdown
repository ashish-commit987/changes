import Popover from '@mui/material/Popover';
import Tooltip from '@mui/material/Tooltip';
import { makeStyles } from '@mui/styles';
import React, { useEffect, useRef, useState } from 'react'
import Zoom from "@mui/material/Zoom";
import Typography from "@mui/material/Typography";
import NewChip from '../newChip/NewChip';

const MasterEnvDropdown = (props) => {
    const classes = useStyles();
    const rootRef = useRef(null);
    const { masterEnvList, selectedMasterEnv, masterEnvChangeHandler, removeFromList, error } = props;
    const [anchorEl, setAnchorEl] = useState(null);
    const [state, setState] = useState({
        masterEnvList: masterEnvList && masterEnvList.length > 0 ? masterEnvList : [],
    })

    useEffect(() => {

        setState(prevState => ({
            ...prevState,
            masterEnvList: masterEnvList
        }));

    }, [masterEnvList]);
    console.log(masterEnvList, "masterEnvListmasterEnvList", state.masterEnvList)

    const handleClick = (event) => {
        setAnchorEl(event.currentTarget);
    };

    const handleClose = () => {
        setAnchorEl(null);
    };

    const open = Boolean(anchorEl);


    function onMasterEnvClick(order) {
        console.log(order, "onMasterEnvClick")
        masterEnvChangeHandler(order);
        setState((prevState) => ({
            ...prevState,
            search: "",
        }))
        handleClose();
    }

    console.log(error, "masterEnvList")

    return (
      <>
        <p className="font-14 color-primary">
          Select Environment Restriction
          <span className="" style={{ color: "red" }}>
            *
          </span>
          <Tooltip
            TransitionComponent={Zoom}
            title={
              <Typography
                variant="body2"
                style={{ whiteSpace: "pre-line", color: "white" }}
              >
                {
                  "In Buildpiper, we have different environments categorized into lower and higher environments. Lower environments are designated for developers, QA, and UAT colleagues, while the higher environment is specifically reserved for production. Therefore, Environment Restriction refers to the environment to which the user wants to associate the VM groups."
                }
              </Typography>
            }
            style={{ marginLeft: "4px" }}
            placement="right"
          >
            <i className="ri-information-line"></i>
          </Tooltip>
        </p>
        <div
          ref={rootRef}
          className={error ? `${classes.root} error` : classes.root}
          onClick={handleClick}
          style={open ? { borderColor: "#0086FF" } : {}}
          role="button"
          tabIndex={0}
          onKeyDown={(e) => {
            if (e.key === "Enter" || e.key === " ") {
              handleClick();
            }
          }}
        >
          <div className="selected-label">
            <div className="selected-env font-14 d-flex align-center avtar">
              {selectedMasterEnv && selectedMasterEnv.length > 0
                ? selectedMasterEnv.map((item) => (
                    <NewChip
                      variant="info"
                      size="md"
                      shape="pill"
                      className="chip-default"
                      ariaLabel={`Remove ${item.tabName}`}
                      label={
                        <div
                          style={{
                            display: "flex",
                            alignItems: "center",
                            justifyContent: "space-between",
                            gap: "8px",
                            width: "100%",
                          }}
                        >
                          <span className="font-12 font-weight-600">
                            {item.tabName}
                          </span>

                          <div
                            onClick={(e) => {
                              e.stopPropagation();
                              removeFromList(item.order);
                            }}
                            role="button"
                            tabIndex={0}
                            onKeyDown={(e) => {
                              if (e.key === "Enter" || e.key === " ") {
                                e.preventDefault();
                                removeFromList(item.order);
                              }
                            }}
                          >
                            <span
                              className="font-14 font-weight-600 cursor-pointer ri-close-fill"
                              style={{ color: "#0086ff" }}
                            />
                          </div>
                        </div>
                      }
                    />
                  ))
                : "Please Select"}
            </div>
          </div>
        </div>

        <Popover
          open={open}
          anchorEl={anchorEl}
          onClose={handleClose}
          anchorOrigin={{
            vertical: "bottom",
            horizontal: "center",
          }}
          transformOrigin={{
            vertical: "top",
            horizontal: "center",
          }}
          PaperProps={{
            style: {
              overflow: "visible",
              marginTop: "10px",
              borderRadius: "6px",
            },
          }}
        >
          <div
            className={classes.popover}
            style={{
              width: rootRef.current ? rootRef.current.clientWidth : "auto",
            }}
          >
            <div className="env-list">
              {state?.masterEnvList.length > 0 ? (
                state.masterEnvList.map((ele, i) => {
                  const isSelected =
                    selectedMasterEnv && selectedMasterEnv.length > 0
                      ? selectedMasterEnv.some((env) => env.order === ele.order)
                      : null;

                  if (ele.tabName.length > 32) {
                    return (
                      <Tooltip key={ele.order} title={ele.tabName}>
                        <div
                          className={
                            isSelected
                              ? "env-item font-14 selected-item"
                              : "env-item font-14"
                          }
                          onClick={() => onMasterEnvClick(ele.order)}
                          role="button"
                          tabIndex={0}
                          onKeyDown={(e) => {
                            if (e.key === "Enter" || e.key === " ") {
                              onMasterEnvClick(ele.order);
                            }
                          }}
                        >
                          <span className="component-env-name">
                            {ele.tabName}
                          </span>
                          {isSelected && (
                            <span
                              className="ri-checkbox-circle-fill font-17"
                              style={{ color: "#0086FF" }}
                            ></span>
                          )}
                        </div>
                      </Tooltip>
                    );
                  } else {
                    return (
                      <div
                        key={ele.order}
                        className={
                          isSelected
                            ? "env-item font-14 selected-item"
                            : "env-item font-14"
                        }
                        onClick={() => onMasterEnvClick(ele.order)}
                        role="button"
                        tabIndex={0}
                        onKeyDown={(e) => {
                          if (e.key === "Enter" || e.key === " ") {
                            onMasterEnvClick(ele.order);
                          }
                        }}
                      >
                        <span className="component-env-name">
                          {ele.tabName}
                        </span>
                        {isSelected && (
                          <span
                            className="ri-checkbox-circle-fill font-17"
                            style={{ color: "#0086FF" }}
                          ></span>
                        )}
                      </div>
                    );
                  }
                })
              ) : (
                <div className="d-flex align-center justify-center width-full">
                  No Result Found
                </div>
              )}
            </div>
          </div>
        </Popover>
      </>
    );
}

