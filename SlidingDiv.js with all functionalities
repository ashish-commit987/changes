                                            backgroundColor: '#F5FAFF',
                                            padding: "6px",
                                            borderRadius: "6px",
                                            display: 'flex',
                                            alignItems: 'center',
                                            marginBottom: "16px"
                                          }}>
                                            <span className='ri-information-line' style={{ fontSize: "16px", color: "#0086FF" }}></span>
