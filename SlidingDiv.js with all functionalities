                                                    />
                                                  }

                                                </div>
                                              </div> :
                                              state.data[0]?.task_type === "INTEGRATION" ?

                                                <div className='pd-20 text-center mt-20 mb-20' style={{ backgroundColor: '#F8F8F8', borderRadius: '8px' }}>
