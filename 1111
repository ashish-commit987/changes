  ...PropTypes.objectOf(PropTypes.any),
}


const EnabledComponentServiceAcount = props => {
  const inherits = props.inherits ? props.inherits : {};
  const prev_state = props.prev_state ? props.prev_state : null
  const [state, setState] = useState(prev_state ? prev_state : getEnabledComponentServiceNameDefaultState())
  const commonFunctions = getCommonFunctions(state, setState, inherits);

  useEffect(() => {
    setState(new_state => ({ ...new_state, ...prev_state }))
  }, [prev_state])

  inherits.validateForm = () => {
    var result = ValidateDataSet(state.data, state.validations);
    if (!result.valid) {
      setState(new_state => ({
        ...new_state,
        error: { ...result.error }
      }))
    }
    var child_valid = true;
    if (state.data.custom_manifest_type == 1) {
      child_valid = state.child_inherits.fileUpload.validateForm().valid;
    } else if (state.data.custom_manifest_type == 2) {
      child_valid = state.child_inherits.gitRepo.validateForm().valid;
    }
    return { valid: result.valid && child_valid };
  }

  inherits.getData = () => {
    var data = {
      manifest_name: state.data.manifest_name,
    };
    if (state.data.custom_manifest_type == 1) {
      var file_data = state.child_inherits.fileUpload.getData();
      data.manifest_meta_data = {
        strategy: "UPLOADED_MANIFEST",
        manifest_file_paths: file_data.files,
      };
    } else if (state.data.custom_manifest_type == 2) {
      var git_data = state.child_inherits.gitRepo.getData();
      data.manifest_meta_data = {
        strategy: "GIT_MANIFEST",
        manifest_file_paths: git_data.file_paths ? git_data.file_paths.split(",") : [],
        manifest_git_repo_id: git_data.git_url ? git_data.git_url : null,
        manifest_git_repo_branch: git_data.branch_name ? git_data.branch_name : null,
      };
    }
    return data;
  }

  inherits.getState = () => {
    var manifest_meta_data = null;
    if (state.data.custom_manifest_type == 1) {
      var file_data = state.child_inherits.fileUpload.getData();
      manifest_meta_data = {
        strategy: "UPLOADED_MANIFEST",
        manifest_file_paths: file_data.files,
      };
    } else if (state.data.custom_manifest_type == 2) {
      var git_data = state.child_inherits.gitRepo.getData();
      manifest_meta_data = {
        strategy: "GIT_MANIFEST",
        manifest_file_paths: git_data.file_paths ? git_data.file_paths.split(",") : [],
        manifest_git_repo_id: git_data.git_url ? git_data.git_url : null,
        manifest_git_repo_branch: git_data.branch_name ? git_data.branch_name : null,
      };
    }
    return {
      ...state,
      manifest_meta_data: manifest_meta_data,
      fileUpload: state.data.custom_manifest_type == 1 ? state.child_inherits.fileUpload.getState() : null,
      gitRepo: state.data.custom_manifest_type == 2 ? state.child_inherits.gitRepo.getState() : null,
    };
  }

  function getFileUploadState() {
    var state_temp = FileUploadDefaultState();
    if (state.fileUpload) {
      state.fileUpload.files.forEach(file_name => {
        if (typeof (file_name) == "string") {
          state_temp.form_data.data.files.push({
            name: file_name
          });
        } else {
          state_temp.form_data.data.files.push(file_name);
        }
      });
    }
    return state_temp;
  }

  function getGitRepoState() {
    var state_temp = GitRepoDefaultState();
    if (state.gitRepo) {
      state_temp.form_data.data = { ...state_temp.form_data.data, ...state.gitRepo };
      state_temp.branch_data.branches = state.gitRepo.branches
    }
    return state_temp;
  }

  return (
    <>
      <div className="card-body">
        <Grid lg={6} direction="row">
          <div className='section'>
            <Input
              type="text"
              name="manifest_name"
              label="Name"
              mandatorySign
              placeholder="Name"
              onChangeHandler={commonFunctions.onChangeHandler}
              data={state.data}
              error={state.error}
            />
          </div>
        </Grid>
        <Grid lg={6} direction="row">
          <div className='section'>
            <Input
              type="radio"
              name="custom_manifest_type"
              label="Choose Option"
              mandatorySign
              onChangeHandler={commonFunctions.onChangeHandler}
              data={state.data}
              error={state.error}
              list={[{ label: 'via File', value: 1 }, { label: 'via Git', value: 2 }]}
            />
          </div>
        </Grid>
        {
          state.data.custom_manifest_type == 1 ?
            <>
              <div>
                <FileUpload inherits={state.child_inherits.fileUpload} state={state.fileUpload ? state.fileUpload.files ? getFileUploadState() : null : null}
                  varient="single" />
              </div>
            </> :
            <ResetComponent inherits={state.child_inherits.fileUpload} />
        }
        {state.data.custom_manifest_type == 2 ?
          <>
            <div>
              <GitRepo single_path={true} inherits={state.child_inherits.gitRepo} state={state.gitRepo ? getGitRepoState() : null} />
            </div>
          </> :
          <ResetComponent inherits={state.child_inherits.gitRepo} />
        }
      </div>
    </>
  )
}

export function getEnabledComponentServiceNameDefaultState() {
  return {
    data: { custom_manifest_type: 1 },
    error: {},
    validations: {
      manifest_name: [VALIDATION_TYPE_REQUIRED],
    },
    child_inherits: {
      fileUpload: {
        "validateForm": () => { return { valid: true } },
        "getState": () => { return {} },
        "getData": () => { return {} }
      },
      gitRepo: {
        "validateForm": () => { return { valid: true } },
        "getState": () => { return {} },
        "getData": () => { return {} }
      }
    }
  };
}





