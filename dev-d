      frequency: r.has_data ? formatCardValue(r.value, r.type) : "—",
      level: safeLevelKey(r.level), 
      lastActivity: r.last_activity
        ? dayjs(r.last_activity).format("DD MMM YYYY, HH:mm")
        : "—",
      _raw: r,
    }));
  };

  const isFirstRender = useRef(true);

  useEffect(() => {
    if (!tabMetrics || noDataAlert) return;
    fetchAllChartsRef.current?.(activeTab);
  }, [tabMetrics]); 
  useEffect(() => {
    if (isFirstRender.current) {
      isFirstRender.current = false;
      return;
    }
    if (!tabMetrics || noDataAlert) return;
    fetchAllChartsRef.current?.(activeTab);
  }, [activeTab]);
  const orgColumns = buildColumns(viewMode, setViewMode, setSelectedService, setShowDrawer, activeTabOriginalKey, handleViewApp);

  const appColumns = buildColumns("app", setViewMode, setSelectedService, setShowDrawer, activeTabOriginalKey, handleViewServiceDetail);

  return (
    <div style={{ fontFamily: "montserrat", color: "#111827" }}>
      {viewMode === "org" ? (
        <>
          <div className="d-flex align-center" style={{ marginBottom: "8px", marginTop: "25px" }}>
            <span className="ri-earth-line font-20 color-icon-secondary" />
            <span className="font-14 font-weight-600 color-icon-secondary ml-8">Organizational Overview</span>
          </div>
          <div style={{ marginTop: "14px", borderBottom: "1px solid #e5e7eb", paddingBottom: "24px", fontSize: "14px", fontWeight: 500 }}>
            <span>Showing details of organisation for <strong>{dayjs(startDate).format("DD-MM-YYYY")}</strong> to <strong>{dayjs(endDate).format("DD-MM-YYYY")} ({dateLabel})</strong></span>
          </div>
        </>
      ) : (
        <>
          <div style={{ marginTop: "31px", marginBottom: "8px" }}>
            <button onClick={handleBack} style={{ display: "inline-flex", alignItems: "center", gap: "8px", padding: "8px 12px", border: "1px solid #d1d5db", borderRadius: "20px", background: "#fff", cursor: "pointer", fontSize: "12px", fontWeight: 600, color: "#2f2f2f" }}>
              <i className="ri-arrow-left-s-line" style={{ fontSize: "16px" }} />
              BACK
            </button>
          </div>
            
          {/* Breadcrumb */}
            <div style={{ display: "flex", alignItems: "center", gap: "6px", marginTop: "12px", fontSize: "14px", color: "#6b7280" }}>
              <i className={viewMode === "org" ? "ri-earth-line" : "ri-apps-line"} style={{ fontSize: "15px" }} />
              <span onClick={handleBack} style={{ cursor: "pointer" }}>{`${viewMode === "org" ? "Organisation" : "App"}`}</span>
              <i className="ri-arrow-right-s-line" />
              <span style={{ color: "#111827", fontWeight: 700 }}>{selectedApp}</span>
            </div>
            
          <div style={{ marginTop: "8px", borderBottom: "1px solid #e5e7eb", paddingBottom: "24px", fontSize: "14px", fontWeight: 500 }}>
            <span>Showing Details of Application <strong>"{selectedApp}"</strong> for <strong>{dateLabel}</strong></span>
          </div>
        </>
      )}
  
      {tabsError && (
        <Box
          sx={{
            display: "flex",
            alignItems: "center",
            gap: "10px",
            padding: "10px 16px",
            border: "1px solid rgba(255, 218, 242, 1)",
            borderRadius: "8px",
            background: "rgba(255, 235, 235, 1)",
            mt: "16px",
            mb: "8px",
            fontSize: "13px",
            fontWeight: 600,
            color: "rgba(229, 55, 55, 1)",
          }}
        >
          <span className="ri-alert-line font-18" style={{ flexShrink: 0 }} />
          No data is available for the selected date range. Please choose a different date range.
        </Box>
      )}

      {(loading.tabs || (tabMetrics === null && !tabsError)) ? (
        <Box sx={{ mt: "15px", mb: "20px" }}>
          <MetricCardSkeleton />
        </Box>
      ) : (
        <div style={{ marginTop: "15px", display: "grid", gridTemplateColumns: "repeat(3, 1fr)", border: "1px solid #e5e7eb", borderRadius: "8px", overflow: "hidden", marginBottom: "20px", background: "#fff", boxShadow: "0 1px 3px rgba(0,0,0,0.06)" }}>
          {TABS.map((t, idx) => {
            const liveData = noDataAlert ? null : deriveTabValues(tabMetrics, t.key);
            const isActive = activeTab === t.key;

            return (
              <Box
                key={t.key}
                onClick={() => !noDataAlert && setActiveTab(t.key)}
                style={{
                  padding: "10px 24px",
                  cursor: noDataAlert ? "default" : "pointer",
                  borderRight: idx < 2 ? "1px solid #d9d9d9" : "none",
                  borderTop: `4px solid ${isActive && !noDataAlert ? BRAND_BLUE : "transparent"}`,
                  borderBottom: isActive && !noDataAlert ? "4px solid #fff" : "4px solid transparent",
                  background: "#fff",
                  transition: "all 0.2s ease",
                  position: "relative",
                  boxShadow: "0px 8px 16px -6px rgba(0, 0, 0, 0.2)"
                }}
                sx={{
                  "&:hover": {
                    backgroundColor: "#F5F9FF !important",
                  },
                }}
              >
                
                <div style={{ display: "flex", alignItems: "center", gap: "8px", marginBottom: "14px", color: isActive || hoveredTab === t.key ? "rgba(47,47,47,1)" : "rgba(120,120,120,1)", fontWeight: isActive || hoveredTab === t.key ? 600 : 500, fontSize: "14px" }}>
                  <span className={t.icon} style={{ fontSize: "20px" }} />
                  {t.title}
                </div>

                {tabsError ? (
                  <div style={{ fontSize: "12px", color: "#2f2f2f", marginTop: "28px" }}>--</div>
                ) : (
                  <>
                    <div style={{ display: "flex", alignItems: "center", gap: "10px", marginTop: "28px" }}>
                      <span style={{ fontSize: "24px", fontWeight: 600, color: isActive || hoveredTab === t.key ? "rgba(47,47,47,1)" : "rgba(120,120,120,1)", lineHeight: 1 }}>
                        {liveData?.value ?? "—"}
                      </span>
                      {liveData?.level && liveData?.levelStyle && (
                        <span style={{ background: liveData.levelStyle.bg, color: liveData.levelStyle.color, border: `1px solid ${liveData.levelStyle.border}`, padding: "2px 8px", borderRadius: "4px", fontSize: "11px", fontWeight: 700 }}>
                          {liveData.level}
                        </span>
                      )}
                    </div>
                    <div style={{ fontSize: "12px", color: "rgba(120,120,120,1)", marginTop: "4px" }}>
                      {t.key.startsWith("changeFailureRate") && liveData?.totalFailures != null
                        ? `${liveData.totalFailures} Total Failures`
                        : liveData?.label ?? "—"
                      }
                    </div>
                  </>
                )}
              </Box>
            );
          })}
        </div>
      )}

      {!tabsError && (() => {
        const FALLBACK_DESCRIPTIONS = {
          deploymentFrequency: "Higher deployment frequency means faster delivery of features and fixes to users.",
          leadTimeToChange: "Lower lead time means changes are reaching users faster after being committed.",
          changeFailureRate: "Lower change failure rate indicates more stable and reliable deployments.",
        };
        const card = tabMetrics?.cards?.find(c => CARD_KEY_MAP[c.name] === activeTab);
        const description = card?.description || FALLBACK_DESCRIPTIONS[activeTabOriginalKey];
        return description ? (
          <div style={{ display: "flex", alignItems: "center", gap: "10px", padding: "6px 12px", border: `1px solid ${BRAND_BLUE}`, borderRadius: "8px", background: "rgba(245, 250, 255, 1)", marginBottom: "20px", fontSize: "12px", color: BRAND_BLUE, fontWeight: 600 }}>
            <span className="ri-information-line font-16" style={{ flexShrink: 0 }} />
            {description}
          </div>
        ) : null;
      })()}

      {noDataAlert ? (
        <>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px" }}>
            <ChartCard icon="ri-bar-chart-fill" title="Deployment Frequency Trend" subtitle="Historical chart uses month-wise data at org/application level." tooltip="Track deployment frequency over time.">
              <EmptyChartState />
            </ChartCard>
            <ChartCard icon="ri-bar-chart-fill" title="Threshold legend" subtitle="Use backend-provided rating metadata wherever available." tooltip="Deploy count split across trigger types.">
              <EmptyChartState />
            </ChartCard>
          </div>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px", marginTop: "24px" }}>
            <ChartCard icon="ri-bar-chart-fill" title="Level distribution" subtitle="Levels are backend-provided and treated as the source of truth." tooltip="Distribution of applications across Elite, High, Medium and Low performance levels.">
              <EmptyChartState />
            </ChartCard>
            <ChartCard icon="ri-bar-chart-fill" title="Most frequently deploying applications" subtitle="Ranking basis is tied only to the selected metric and active filters." tooltip="Ranking basis is tied only to the selected metric and active filters.">
              <EmptyChartState />
            </ChartCard>
          </div>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px", marginTop: "20px" }}>
            <ChartCard icon="ri-bar-chart-fill" title="Applications with lowest deployment frequency" subtitle="Attention list uses the opposite sorting direction for this metric." tooltip="Attention list uses the opposite sorting direction for this metric.">
              <EmptyChartState />
            </ChartCard>
            <ChartCard icon="ri-bar-chart-fill" title="Application deployment consistency" subtitle="Cell intensity represents deployment count for the period." tooltip="Darker cells indicate higher deployment counts for that month.">
              <EmptyChartState />
            </ChartCard>
          </div>
          <div style={{ marginTop: "20px" }}>
            <DorametricsGenericTable
              icon="ri-apps-line"
              title="Applications metric table"
              subtitle="Columns change based on the selected DORA metric."
              tooltip="Per-application DORA metrics for the selected time range."
              data={[]}
              columns={orgColumns}
              loading={false}
              pageSize={PAGE_SIZE}
              externalPagination={true}
              currentPage={1}
              totalPages={0}
              onPageChange={() => { }}
              onSearch={() => { }}
              onFilterChange={() => { }}
              searchable
              searchKeys={["service"]}
              filters={[
                { key: "level", label: "Level", options: ["all", "Elite", "High", "Medium", "Low"] },
                { key: "application", label: "Application", options: ["all"] },
              ]}
              onSecondaryFilterChange={() => { }}
              emptyMessage="No data available for the selected date range."
            />
          </div>
        </>
      ) : tabsError ? (
        <>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px" }}>
            <ChartCard icon="ri-bar-chart-fill" title={activeTabOriginalKey === "deploymentFrequency" ? "Deployment Frequency Trend" : activeTabOriginalKey === "leadTimeToChange" ? "Average Lead Time Trend" : "Change Failure Rate Trend"} subtitle="Historical chart uses month-wise data at org/application level." tooltip="Track deployment frequency over time.">
              <EmptyChartState />
            </ChartCard>
            <ChartCard icon="ri-bar-chart-fill" title="Threshold legend" subtitle="Use backend-provided rating metadata wherever available." tooltip="Deploy count split across trigger types.">
              <EmptyChartState />
            </ChartCard>
          </div>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px", marginTop: "24px" }}>
            <ChartCard icon="ri-bar-chart-fill" title="Level distribution" subtitle="Levels are backend-provided and treated as the source of truth." tooltip="Distribution of applications across Elite, High, Medium and Low performance levels.">
              <EmptyChartState />
            </ChartCard>
            <ChartCard icon="ri-bar-chart-fill" title={activeTabOriginalKey === "deploymentFrequency" ? "Most frequently deploying applications" : activeTabOriginalKey === "leadTimeToChange" ? "Fastest applications by lead time" : "Lowest failure-rate applications"} subtitle="Ranking basis is tied only to the selected metric and active filters." tooltip="Ranking basis is tied only to the selected metric and active filters.">
              <EmptyChartState />
            </ChartCard>
          </div>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px", marginTop: "20px" }}>
            <ChartCard icon="ri-bar-chart-fill" title="Applications with lowest deployment frequency" subtitle="Attention list uses the opposite sorting direction for this metric." tooltip="Attention list uses the opposite sorting direction for this metric.">
              <EmptyChartState />
            </ChartCard>
            <ChartCard icon="ri-bar-chart-fill" title={activeTabOriginalKey === "deploymentFrequency" ? "Application deployment consistency" : activeTabOriginalKey === "leadTimeToChange" ? "Lead-time percentiles" : "Biggest contributors to failed changes"} subtitle="" tooltip="">
              <EmptyChartState />
            </ChartCard>
          </div>
          <div style={{ marginTop: "20px" }}>
            <DorametricsGenericTable
              icon="ri-apps-line"
              title="Applications metric table"
              subtitle="Columns change based on the selected DORA metric."
              tooltip="Per-application DORA metrics for the selected time range."
              data={[]}
              columns={orgColumns}
              loading={false}
              pageSize={PAGE_SIZE}
              externalPagination={true}
              currentPage={1}
              totalPages={0}
              onPageChange={() => { }}
              onSearch={() => { }}
              onFilterChange={() => { }}
              searchable
              searchKeys={["service"]}
              filters={[
                { key: "level", label: "Level", options: ["all", "Elite", "High", "Medium", "Low"] },
                { key: "application", label: "Application", options: ["all"] },
              ]}
              onSecondaryFilterChange={() => { }}
              emptyMessage="Failed to load data."
            />
          </div>
        </>
      ) : (
        <>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px" }}>
            <ChartCard
              icon="ri-bar-chart-fill"
              title={
                activeTabOriginalKey === "deploymentFrequency" ? "Deployment Frequency Trend" :
                  activeTabOriginalKey === "leadTimeToChange" ? "Average Lead Time Trend" :
                    "Change Failure Rate Trend"
              }
              subtitle="Historical chart uses month-wise data at org/application level."
              tooltip="Track deployment frequency over time."
            >
              { trendLoading ? (
                <DeploymentFrequencyTrendSkeleton />
              ) : trendError ? (
                <EmptyChartState />
              ) : (
                <TrendChart
                  key={`${activeTab}-${trendData ? "live" : "empty"}`}
                  tabKey={activeTab}
                  data={buildTrendChartData(trendData)}
                  activeTab={activeTabOriginalKey}
                />
              )}
            </ChartCard>

            <ChartCard
              icon="ri-bar-chart-fill"
              title="Threshold legend"
              subtitle="Use backend-provided rating metadata wherever available."
              tooltip="Deploy count split across trigger types."
            >
               {thresholdFetching ? (
                  <ThresholdSkeleton />
                ) : thresholdError ? (
                  <EmptyChartState />
                ) : (() => {
                  const rows = buildThresholdRows(thresholdData);
                  return rows
                    ? <ThresholdLegend thresholds={rows.thresholds} footerNote={rows.footerNote} />
                    : <EmptyChartState />;
                })()}
            </ChartCard>
          </div>

          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px", marginTop: "24px" }}>

            <ChartCard
              icon="ri-bar-chart-fill"
              title="Level distribution"
              subtitle="Levels are backend-provided and treated as the source of truth."
              tooltip="Distribution of applications across Elite, High, Medium and Low performance levels."
            >
              {levelDistFetching ? (
                <DonutChartSkeleton />
              ) : levelDistError ? (
                <EmptyChartState />
              ) : (
                <>
                  <DonutChart levelDistribution={buildLevelDistData(levelDistData)} />
                  {buildLevelDistData(levelDistData)?.length > 0 && (
                    <Box sx={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "12px", marginTop: "12px" }}>
                      {buildLevelDistData(levelDistData).map((d) => (
                        <Box key={d.name} sx={{ height: "31px", border: "1px solid #D9D9D9", borderRadius: "6px", background: "#F8F8F8", padding: "0 16px", display: "flex", alignItems: "center", justifyContent: "space-between" }}>
                          <Box sx={{ display: "flex", alignItems: "center", gap: "12px" }}>
                            <Box sx={{ width: "12px", height: "12px", borderRadius: "50%", background: d.color }} />
                            <Typography sx={{ fontSize: "12px", fontWeight: 700, color: "#000", textTransform: "uppercase", lineHeight: 1 }}>
                              {d.name}
                            </Typography>
                          </Box>
                          <Typography sx={{ fontSize: "12px", fontWeight: 700, color: "#222" }}>
                            {d.y}
                          </Typography>
                        </Box>
                      ))}
                    </Box>
                  )}
                </>
              )}
            </ChartCard>

            <ChartCard
              icon="ri-bar-chart-fill"
              title={
                activeTabOriginalKey === "deploymentFrequency" ? "Most frequently deploying applications" :
                  activeTabOriginalKey === "leadTimeToChange" ? "Fastest applications by lead time" :
                    "Lowest failure-rate applications"
              }
              subtitle="Ranking basis is tied only to the selected metric and active filters."
              tooltip="Ranking basis is tied only to the selected metric and active filters."
            >
              {rankingsFetching ? (
                <BarChartSkeleton />
              ) : rankingsError ? (
                <EmptyChartState />
              ) : (
                <BarChart
                  apps={buildRankingsChartData(rankingsData, viewMode)}
                  tooltipUnit={
                    activeTabOriginalKey === "leadTimeToChange" ? "minutes" :
                      activeTabOriginalKey === "changeFailureRate" ? "percentage" :
                        "count"
                  }
                          activeTab={activeTabOriginalKey}
                />
              )}
            </ChartCard>
          </div>

          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "20px", marginTop: "20px" }}>
            <ChartCard
              icon="ri-bar-chart-fill"
              title="Applications with lowest deployment frequency"
              subtitle="Attention list uses the opposite sorting direction for this metric."
              tooltip="Attention list uses the opposite sorting direction for this metric."
            >
              {worstRankingsFetching ? (
                <RankedList loading={true} />
              ) : worstRankingsError ? (
                <EmptyChartState />
              ) : (
                <RankedList rankedApps={buildRankedListData(worstRankingsData, viewMode) ?? []} />
              )}
            </ChartCard>

            {activeTabOriginalKey === "leadTimeToChange" ? (
              <ChartCard icon="ri-bar-chart-fill" title="Lead-time percentiles" subtitle="Use percentiles to avoid average-only interpretation." tooltip="p50 is the median; p75 and p90 reveal the long tail of your pipeline.">
                {percentilesLoading ? (
                  <PercentileChartSkeleton />
                ) : percentilesError ? (
                  <EmptyChartState />
                ) : (() => {
                  const built = buildPercentilesData(percentilesData);
                  return built ? <PercentileBarChart percentiles={built} /> : <EmptyChartState />;
                })()}
              </ChartCard>
            ) : activeTabOriginalKey === "changeFailureRate" ? (
              <ChartCard icon="ri-bar-chart-fill" title="Biggest contributors to failed changes" subtitle="Shown only when failed-change counts are available." tooltip="Shown only when failed-change counts are available.">
                {contributorsFetching ? (
                  <BarChartSkeleton />
                ) : contributorsError ? (
                  <EmptyChartState />
                ) : (() => {
                  const built = buildContributorsData(contributorsData, viewMode);
                  return built ? <FailedChangesComboChart contributorsData={built} /> : <EmptyChartState />;
                })()}
              </ChartCard>
            ) : (
              <ChartCard icon="ri-bar-chart-fill" title="Application deployment consistency" subtitle="Cell intensity represents deployment count for the period." tooltip="Darker cells indicate higher deployment counts for that month.">
                        {consistencyLoading ? (
                          <HeatmapSkeleton />
                        ) : consistencyError ? (
                          <EmptyChartState />
                        ) : (() => {
                          const built = buildConsistencyData(consistencyData, viewMode);
                          return built ? (
                            <HeatmapChart
                              consistencyData={built.consistencyData}
                              months={built.months}
                              total={built.total}
                              page={consistencyPage}
                              pageSize={CONSISTENCY_PAGE_SIZE}
                              search={consistencySearch}
                              onPageChange={(newPage) => {
                                setConsistencyPage(newPage);
                                fetchConsistency(activeTab, newPage, consistencySearch);
                              }}
                              onSearchChange={(val) => {
                                setConsistencySearch(val);
                                setConsistencyPage(0);
                                fetchConsistency(activeTab, 0, val);
                              }}
                            />
                          ) : <EmptyChartState />;
                        })()}
              </ChartCard>
            )}
          </div>

          <div style={{ marginTop: "20px" }}>
            {viewMode === "org" ? (
              <DorametricsGenericTable
                icon="ri-apps-line"
                title="Applications metric table"
                subtitle="Columns change based on the selected DORA metric."
                tooltip="Per-application DORA metrics for the selected time range."
                data={tableError ? [] : buildTableRows(tableData)}
                columns={orgColumns}
                loading={tableFetching}
                pageSize={PAGE_SIZE}
                externalPagination={true}
                currentPage={tablePage + 1}
                totalPages={Math.ceil(tableTotal / PAGE_SIZE)}
                onPageChange={(page) => handleTablePageChange(page - 1)}
                onSearch={handleTableSearch}
                onFilterChange={handleTableLevelFilter}
                searchable
                searchKeys={["service"]}
                filters={[
                  { key: "level", label: "Level", options: ["all", "Elite", "High", "Medium", "Low"] },
                  { key: "application", label: "Application", options: appFilterOptsFetching ? ["all"] : appFilterOptions },
                ]}
                onSecondaryFilterChange={handleTableAppFilter}
                emptyMessage={tableError ? "Failed to load data." : "No applications found."}
              />
            ) : (
              <DorametricsGenericTable
                icon="ri-settings-3-line"
                title={`Services metric table of Application "${selectedApp}"`}
                subtitle="Select a service to filter or click View Details for a breakdown."
                tooltip="Per-service DORA metrics for the selected application."
                data={appTableError ? [] : buildAppTableRows(appTableData)}
                columns={appColumns}
                loading={appTableFetching}
                pageSize={PAGE_SIZE}
                totalCount={appTableTotal}
                currentPage={appTablePage + 1}
                onPageChange={(page) => {
                  const zeroBasedPage = page - 1;
                  setAppTablePage(zeroBasedPage);
                  fetchAppTable(selectedApp, zeroBasedPage, appTableSearch, appTableLevel, appTableService);
                }}
                onSearch={(v) => { setAppTableSearch(v); setAppTablePage(0); fetchAppTable(selectedApp, 0, v, appTableLevel, appTableService); }}
                onFilterChange={(v) => { setAppTableLevel(v); setAppTablePage(0); fetchAppTable(selectedApp, 0, appTableSearch, v, appTableService); }}
                externalPagination={true}
                totalPages={Math.ceil(appTableTotal / PAGE_SIZE)}
                searchable
                searchKeys={["service"]}
                filters={[
                  { key: "level", label: "Level", options: ["Elite", "High", "Medium", "Low"] },
                  { key: "service", label: "Service", options: serviceOptsFetching ? ["all"] : serviceOptions },
                ]}
                onSecondaryFilterChange={handleAppTableServiceFilter}
                emptyMessage={appTableError ? "Failed to load data." : "No services found."}
              />
            )}
          </div>
        </>
      )}

      <CustomDateRangePopover anchorEl={dateRangeAnchor} open={Boolean(dateRangeAnchor)} onClose={handleDateRangeClose} onApply={handleDateRangeApply} />
      <ServiceInfoDrawer
        open={showDrawer}
        onClose={handleCloseDrawer}
        appName={selectedApp}
        loading={svcDetailLoading}
        error={svcDetailError}
        data={svcDetail}
        activeTab={activeTabOriginalKey}
      />
    </div>
  );
};

export default DoraMetrics;
