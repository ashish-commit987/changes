function TrendChart({ tabKey, data,activeTab }) {
  if (!data) return <EmptyChartState />;

  const containerRef = useRef(null);
  const chartRef = useRef(null);

  const fmt = (val) => formatCardValue(val, data.type ?? "INT");
  const seriesKey = data?.trend?.join(",") ?? "";

  useEffect(() => {
    if (!containerRef.current) return;
    if (chartRef.current) chartRef.current.destroy();

    const xCategories = data.months;
    const trendLen = data.trend.length;
    const step = Math.max(1, Math.floor(trendLen / xCategories.length));
    const rawData = xCategories.map(
      (_, i) => data.trend[i * step] ?? data.trend[trendLen - 1]
    );

    const trendSeries = rawData.map(v => (v === null || v === undefined) ? 0 : v);

    chartRef.current = Highcharts.chart(containerRef.current, {
      chart: { type: "areaspline", backgroundColor: "transparent", animation: { duration: 500 }, style: { fontFamily: "inherit" }, marginTop: 10 },
      title: { text: null }, credits: { enabled: false }, legend: { enabled: false },
      xAxis: {
        categories: xCategories, lineColor: "#d1d5db", lineWidth: 1, tickLength: 0,
        labels: { style: { color: "#6b7280", fontSize: "12px" } },
      },
      yAxis: {
        title: { text: data.yAxisLabel, style: { color: "#9ca3af", fontSize: "11px", fontWeight: 500 }, margin: 12 },
        gridLineWidth: 0, lineColor: "#d1d5db", lineWidth: 1, min: 0,
        labels: { style: { color: "#6b7280", fontSize: "11px" }, formatter() { return fmt(this.value); } },
      },
      tooltip: {
        backgroundColor: "#ffffff",
        borderColor: "transparent",
        borderRadius: 8,
        style: { color: "#1e293b", fontSize: "12px" },
        formatter() {
          const value =
            this.point.actualValue !== undefined
              ? this.point.actualValue
              : this.y;

         if(activeTab === "deploymentFrequency"){
            return `<b>${this.x}</b><br/>${"Deployment count"}: <b>${fmt(value)}</b>`;
          }
          else if(activeTab === "leadTimeToChange"){
            return `<b>${this.x}</b><br/>${"Average Lead Time"}: <b>${fmt(value)}</b>`;
          }
          else if(activeTab === "changeFailureRate"){
            return `<b>${this.x}</b><br/>${"Change Failure Rate"}: <b>${fmt(value)}</b>`;
          }
        },
      },
      plotOptions: {
        areaspline: {
          color: BRAND_BLUE,
          fillColor: { linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 }, stops: [[0, Highcharts.color(BRAND_BLUE).setOpacity(0.12).get("rgba")], [1, Highcharts.color(BRAND_BLUE).setOpacity(0.01).get("rgba")]] },
          lineWidth: 1,
          marker: { enabled: false },
          states: {
            hover: { lineWidth: 3 }
          },
        },
      },
      series: [
        {
          type: "areaspline",
          name: data.chartTitle,
          data: trendSeries,
          color: BRAND_BLUE,
          lineWidth: 2,
          marker: {
            enabled: false,
            radius: 4,
            states: {
              hover: {
                enabled: true,
                radiusPlus: 2,
              },
            },
          },
        },
      ],
    });

    return () => { if (chartRef.current) { chartRef.current.destroy(); chartRef.current = null; } };

  }, [tabKey, seriesKey]);

  return <div ref={containerRef} style={{ width: "100%", height: "320px" }} />;
}
