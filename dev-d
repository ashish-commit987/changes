function BarChart({ apps, tooltipUnit = "percentage", activeTab }) {

  if(!apps) return <EmptyChartState />;
  const containerRef = useRef(null);
  const chartRef = useRef(null);
  useEffect(() => {
    if (!containerRef.current) return;
    if (chartRef.current) chartRef.current.destroy();
    const categories = apps.map((a) => a.name);
    const maxVal = Math.max(...apps.map((a) => a.value ?? 0), 10);
    const chartMax = Math.ceil(maxVal * 1.0);
    chartRef.current = Highcharts.chart(containerRef.current, {
      chart: { type: "bar", backgroundColor: "transparent", height: apps.length * 55 + 120, style: { fontFamily: "inherit" } },
      title: { text: null }, credits: { enabled: false }, legend: { enabled: false },
      xAxis: { categories, title: { text: null }, lineColor: "#d1d5db", lineWidth: 1, tickWidth: 0, labels: { style: { color: "#374151", fontSize: "11px", fontWeight: 500 } } },
      yAxis: { min: 0, max: chartMax, title: { text: "Frequency", style: { color: "#9ca3af", fontSize: "12px" } }, gridLineWidth: 0, lineColor: "#d1d5db", lineWidth: 1, tickColor: "#d1d5db", tickWidth: 1, labels: { style: { color: "#9ca3af", fontSize: "10px" } } },
      // After
      tooltip: {
        backgroundColor: "#ffffff",
        borderColor: "#e5e7eb",
        borderRadius: 8,
        shadow: true,
        style: { fontSize: "12px" },
        formatter() {
          const label = tooltipUnit === "minutes"
            ? (() => {
              const total = Math.round(this.y);
              const d = Math.floor(total / 1440);
              const h = Math.floor((total % 1440) / 60);
              const m = total % 60;
              if (d > 0) return h > 0 ? `${d}d ${h}h` : `${d}d`;
              if (h > 0 && m > 0) return `${h}h ${m}m`;
              if (h > 0) return `${h}h`;
              return `${m}m`;
            })()
            : tooltipUnit === "count"
              ? String(Math.round(this.y))
              : `${Number(this.y).toFixed(1)}%`;
          const metricName = tooltipUnit === "minutes" ? "Lead time"
            : tooltipUnit === "count" ? "Frequency"
              : "Rate";
