const buildDateLabel = (start, end) => {
  if (!start || !end) return "last 30 days";
  const s = dayjs(start).startOf("day");
  const e = dayjs(end).startOf("day");
  const today = dayjs().startOf("day");
  const days = e.diff(s, "day");
  if (s.isSame(today, "day") && e.isSame(today, "day")) return "today";
  if (s.isSame(today.subtract(1, "day"), "day") && e.isSame(today.subtract(1, "day"), "day")) return "yesterday";
  if (days === 7) return "last 7 days";
  if (days === 14) return "last 14 days";
  if (days === 30) return "last 30 days";
  if (days === 90) return "last 90 days";
  if (days === 181) return "last 181 days";
  if (days === 365) return "last 365 days";
  return `last ${days} days`;
}; 
