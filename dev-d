}

function PercentileBarChart({ percentiles }) {
  if(!percentiles) return <EmptyChartState />;
  const containerRef = useRef(null);
  const chartRef = useRef(null);
  const fmtMinutes = (m) => {
    if (m >= 1440) { const d = Math.floor(m / 1440); const h = Math.floor((m % 1440) / 60); return h > 0 ? `${d}d ${h}h` : `${d}d`; }
    const h = Math.floor(m / 60); const min = m % 60;
    if (h > 0 && min > 0) return `${h}h ${min}m`; if (h > 0) return `${h} hrs`; return `${min}m`;
  };
  useEffect(() => {
    if (!containerRef.current) return;
    if (chartRef.current) chartRef.current.destroy();
    const maxVal = Math.max(...percentiles.map((p) => p.minutes));
    const ceiling = Math.ceil(maxVal / 100) * 100 + 100;
    const tickStep = Math.ceil(ceiling / 4 / 50) * 50;
    const tickVals = [];
    for (let v = 0; v <= ceiling; v += tickStep) tickVals.push(v);
    chartRef.current = Highcharts.chart(containerRef.current, {
      chart: { type: "column", backgroundColor: "transparent", style: { fontFamily: "inherit" }, height: 380, animation: { duration: 600 }, marginLeft: 80, marginRight: 20 },
      title: { text: null }, credits: { enabled: false }, legend: { enabled: false },
      xAxis: { categories: percentiles.map((p) => p.label), lineColor: "#e5e7eb", lineWidth: 1, tickWidth: 0, gridLineWidth: 0, labels: { style: { color: "#6b7280", fontSize: "13px", fontWeight: 500 }, align: "right" } },
      yAxis: { min: 0, max: ceiling, tickPositions: tickVals, title: { text: null }, gridLineWidth: 0, lineColor: "#d1d5db", lineWidth: 1, tickColor: "#d1d5db", tickWidth: 1, labels: { style: { color: "#6b7280", fontSize: "11px" }, formatter() { return this.value === 0 ? "0" : fmtMinutes(this.value); } } },
      tooltip: {
        backgroundColor: "#ffffff", borderColor: "#e5e7eb", borderRadius: 8, shadow: true, style: { fontSize: "12px", color: "#374151" }, formatter() {
          const totalMinutes = Math.floor(this.y);
          const hrs = Math.floor(totalMinutes / 60);
          const mins = totalMinutes % 60;
          const formatted = `${hrs}hr ${mins}min`;
          return `<b>${this.x}</b><br/>Lead time: <b>${formatted}</b>`;
        } },
      plotOptions: { column: { borderRadius: 8, pointWidth: 100, groupPadding: 0.15, states: { hover: { brightness: -0.04 } }, dataLabels: { enabled: false } } },
      series: [{ name: "Lead time", data: percentiles.map((p) => ({ y: p.minutes, color: { linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 }, stops: [[0, "rgba(0, 134, 255, 0.95)"], [1, "rgba(140, 200, 255, 0.50)"]] } })) }],
    });
    return () => { if (chartRef.current) { chartRef.current.destroy(); chartRef.current = null; } };
  }, [percentiles]);
  return <div ref={containerRef} style={{ width: "100%" }} />;
}

