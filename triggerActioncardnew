    function fetchSystemSettingsDataSuccess(data) {
        let branchRequired = false;
        let disable_parallel_build = null;
        let build_runtime_var_support = null;

        data.forEach(item => {
            switch (item.key) {
                case "BRANCH_SELECTION_REQUIRED_FOR_EVERY_BUILD":
                    branchRequired = item.value === "true";
                    break;
                case "DISABLE_PARALLEL_BUILD":
                    disable_parallel_build = item;
                    break;
                case "BUILD_RUNTIME_ENV_VARIABLE":
                    build_runtime_var_support = item.value === "true";
                    break;
                case "SUPPORT_EXTERNAL_REPO_CONFIGRATION":
                    setSupportExternalConfig(item.value === "true");
                    break;
                case "MULTIPLE_BUILD_CONFIGURATION":
                    setMultipleBuildEnabled(item.value === "true");
                    break;
            }
        });

        console.log(branchRequired, 'bgf')
        setState(new_state => ({
            ...new_state,
            data_loading: "SUCCESS",
            branchRequired: branchRequired?.value == 'true' ? true : false,
            disable_parallel_build: disable_parallel_build,
            build_runtime_var_support: build_runtime_var_support,
