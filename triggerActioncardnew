    function formatAdvanceConfDataForSave(panel_data) {
        const post_data = {};
        let env_ci_run_time_variable = [];

        post_data.project_ci_scope_id = null;

        post_data.shallow_cloning = Boolean(panel_data.data.shallow_cloning);

        post_data.sonar_project_key = panel_data.ci_scope
            ? panel_data.ci_scope.data.sonar_project_key
            : null;

        post_data.env_ci_build_variable = panel_data.key_value
            ? keyValueParser(panel_data.key_value)
            : null;

        post_data.env_ci_build_label = panel_data.env_build_labels
            ? keyValueParserForBuildLabels(panel_data.env_build_labels)
            : [];

        if (
            panel_data.env_runtime_variables &&
            panel_data.env_runtime_variables.runtime_childs
        ) {
            Object.keys(panel_data.env_runtime_variables.runtime_childs).forEach(key => {
            if (
                key === "data" ||
                key === "child_inherits" ||
                key === "show_view" ||
                key === "count"
            ) {
                return;
            }

            const emptyDir =
                panel_data.env_runtime_variables.runtime_childs[key].data;

            const emptyDirData = {
                env_key: emptyDir.env_key,
                env_value: emptyDir.env_value
            };

            if (emptyDir.id) {
                emptyDirData.id = emptyDir.id;
            }

            env_ci_run_time_variable.push(emptyDirData);
            });
        }

        post_data.env_ci_run_time_variable = env_ci_run_time_variable;

        return post_data;
    }

