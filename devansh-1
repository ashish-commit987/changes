                          className="radio-controller"
                          name={name}
                          radioGroup={radioGroup}
                          checked={data[name] == radio.value}
                          value={radio.value}
                          onChange={onChangeHandler}
                          disabled={index == unDisabled_index ? false : onChangeHandler ? false : true}
                        />
                      }
                      label={radio.label} />

                  ))
                }
              </RadioGroup>
              :
              props.variant !== 'version-options' ? <RadioGroup row className="form-class">
