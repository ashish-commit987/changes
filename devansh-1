            </div>
            :
            <div className="input-component d-flex f-direction-column" style={{ gap: props.gap ? props.gap : "var(--space-5)" }}>
              {
                label && type !== "switch" && inputCase != "cache_switch" ?

                  <div className="d-flex space-between ">
                    {
                      type !== "round-checkbox" &&
                      <span className={"d-flex space-between align-center"} style={{ color: "var(--color-content-primary)", fontWeight: "var(--font-weight-500)", fontSize: "var(--font-14)", lineHeight: 'var(--line-height-17-07)', gap: "var(--space-5)" }}>
                        <label className={jiraOperation || info ? classes.InputLabel + " " + classes.AlignLabel + " " + " label-controller" : classes.InputLabel + " " + " label-controller"} >
                          {label}
                          <span style={mandatorySign ? { color: 'var(--color-error-500)' } : { display: 'none' }}>*</span>

                          {jiraOperation || info ?
                            <>
                              <Tooltip TransitionComponent={Zoom} title={info ? info : jiraOperationInfo} style={{ marginLeft: "var(--space-4)" }} placement="right">
                                <i className="ri-information-line font-14 color-secondary"></i>
                              </Tooltip>
                              {
                                props.varient == "database" && <span className="Y6 " style={{ backgroundColor: "rgb(0, 134, 255)" }}>coming soon</span>
                              }
                            </>
                            : ""}
                          {jira_status ?
                            <Tooltip TransitionComponent={Zoom} title={"This is the list of valid Jira statuses"} style={{ marginLeft: "var(--space-4)" }} placement="right">
                              <i className="ri-information-line"></i>
                            </Tooltip>
                            : ""}
                        </label>
                      </span>
                    }

                    {props.extraDiv ? props.extraDiv : null}

                  </div>


                  : null
              }
              {getFieldBasedOnType()}
              {
                paramsHeading &&
                <span className={"subheading-input-label" + " " + " sub-heading-controller"}>{paramsHeading}</span>
              }
              {
                error[name] && error[name].length > 0 ?
                  typeof (error[name]) == "string" ?
                    <Tooltip title={error[name]}>
                      <p className="text-ellipsis-340 error-message">{error[name]}</p>
                    </Tooltip>
                    :
                    <div className="error-message">
                      {
                        error[name].map((error2, key) => (
                          error2 + (key + 1 != error[name].length ? ", " : "")
                        ))
                      }
                    </div>
                  : null
              }
            </div>

      }
    </>
  );
}

Input.propTypes = {
  ...PropTypes.objectOf(PropTypes.any),
}
