                onChangeHandler={onChangeHandler}
                remove_default_value={remove_default_value}
                select_default_value={select_default_value}
                list={list}
              />
            );
          }
          return (

            <select style={style} name={name} value={data[name]} className={!error[name] || error[name].length == 0 ? "select" : "select error"} onChange={onChangeHandler} disabled={onChangeHandler ? false : true} data-testid={resolvedTestId}>
