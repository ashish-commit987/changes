            placeholder={placeholder}
            value={value}
            onKeyDown={onKeyDown}
            onChange={onChangeHandler}
            disabled={onChangeHandler ? false : true}
            onKeyPress={varient == "handle-keys" ? props.onKeyPress : () => { }}
            maxLength={maxLength}
            data-testid={resolvedTestId}
          />
