              >
                {select_default_value ? select_default_value : "Please Select"}
              </option>
            )}

            {/* Render options from list */}
            {list && list.map((option) => (
              <option
                key={option.id}
                className="selectoptions"
                style={{ fontFamily: "Montserrat, sans-serif" }}
