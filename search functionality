                                            <div className={classes.settings_sidebar}>
                                                <div
                                                    className={`back-btn ${classes.back_button}`}
                                                    onClick={navigateBack}
                                                >
                                                    <i className={`ri-arrow-left-line ${classes.back_icon}`}></i>
                                                    <span>BACK</span>
                                                </div>
                                                <div className={classes.search_bar}>
                                                    <div className={classes.search_wrap}>
                                                        <span
                                                            className={`ri-search-line ${classes.search_icon}`}
                                                        />
                                                        <input
                                                            type="text"
                                                            placeholder="Search"
                                                            className={classes.search_input}
                                                            value={state.search_query}
                                                            onChange={(e) => setstate(prev => ({ ...prev, search_query: e.target.value }))}
                                                        />
                                                    </div>
                                                </div>
                                                <div ref={sidebarScrollRef} className={`${classes.default_scroll} ${classes.sidebar_scroll}`}>
                                                    <div className={classes.sidebar_title}>
                                                        System Properties
                                                    </div>
                                                    {(() => {
                                                        if (state.tab_list.length === 0) {
                                                            return <p style={{ padding: '20px', color: '#888', fontSize: '12px', textAlign: 'center' }}>No matching categories found</p>;
                                                        }

                                                        return (
                                                            <div className={classes.category_list}>
                                                                {state.tab_list.map(tab => {
                                                                    const isActive = tab.order === state.selected_tab;
                                                                    return (
                                                                        <div
                                                                            key={tab.order}
                                                                            className={`${classes.category_item} ${isActive ? classes.category_item_active : ''}`}
                                                                            onClick={() => updateSelectedTab(tab.order)}
                                                                        >
                                                                            <i className={`${tab.icon} ${classes.category_icon}`} />
                                                                            <span>{tab.tabName}</span>
                                                                        </div>
                                                                    );
                                                                })}
                                                            </div>
                                                        );
                                                    })()}
                                                </div>
                                            </div>
                                            <div className={`p-relative ${classes.content_panel}`}>
                                                <div className={`pd-10 ${classes.content_header}`}>
                                                    <div className={classes.nav_button_group}>
                                                        <button
                                                            className={`${classes.nav_button} ${classes.nav_button_prev} ${isBackDisabled ? classes.disabled_nav_button : ''}`}
                                                            onClick={handleHistoryBack}
                                                            disabled={isBackDisabled}
                                                        >
                                                            <i className={`ri-arrow-left-line ${classes.nav_button_icon}`}></i>
                                                        </button>
                                                        <button
                                                            className={`${classes.nav_button} ${classes.nav_button_next} ${isForwardDisabled ? classes.disabled_nav_button : ''}`}
                                                            onClick={handleHistoryForward}
                                                            disabled={isForwardDisabled}
                                                        >
                                                            <i className={`ri-arrow-right-line ${classes.nav_button_icon}`}></i>
                                                        </button>
                                                    </div>
                                                    <div>
                                                        <p className={classes.content_title}>
                                                            {state.selected_sub_category ? state.selected_sub_category.name : state.current_tab_name}
                                                        </p>
                                                        <p className={classes.content_description}>
                                                            {state.selected_sub_category ? state.selected_sub_category.description : state.current_tab_description}
                                                        </p>
                                                    </div>
                                                </div>
                                                {
                                                    single_item.single_item_data_loading ?
                                                        <div className={classes.content_loading_state}>
                                                            <div className={`${classes.skeleton_section_label} ${classes.no_flex}`}>
                                                                <GenericSkeleton width="120px" height={12} />
                                                            </div>
                                                            {[...Array(7)].map((_, i) => (
                                                                <div key={i} className={classes.skeleton_item_row}>
                                                                    <div className={`${classes.skeleton_circle_offset} ${classes.no_flex}`}>
                                                                        <GenericSkeleton variant="circle" width={40} height={40} />
                                                                    </div>
                                                                    <div className={`${classes.skeleton_radius} ${classes.no_flex}`}>
                                                                        <GenericSkeleton width="650px" height={35} />
                                                                    </div>
                                                                </div>
                                                            ))}
                                                        </div>
                                                        :
                                                        single_item.error_in_single_item ?
                                                            <div className='' >
                                                                <p style={{ padding: '20px', color: '#888', fontSize: '12px', textAlign: 'center' }}>No matching categories found</p>
                                                            </div>
                                                            :
                                                            (() => {
                                                                const filteredSubCategories = (() => {
                                                                    if (!state.search_query) {
                                                                        return single_item.available_input_fields || [];
                                                                    }
                                                                    const matchedCategory = state.available_settings.find(cat => cat.id === state.selected_tab);
                                                                    const matchedSubCategoryIds = new Set(
                                                                        (matchedCategory?.types || matchedCategory?.settingstype_set || [])
                                                                            .map(t => t.id)
                                                                    );
                                                                    return (single_item.available_input_fields || []).filter(subCat => {
                                                                        if (matchedSubCategoryIds.has(subCat.id)) return true;
                                                                        const query = state.search_query.toLowerCase();
                                                                        if (subCat.name && subCat.name.toLowerCase().includes(query)) return true;
                                                                        if (subCat.description && subCat.description.toLowerCase().includes(query)) return true;
                                                                        return false;
                                                                    });
                                                                })();

                                                                if (filteredSubCategories.length === 0) {
                                                                    return <p style={{ padding: '20px', color: '#888', fontSize: '12px', textAlign: 'center' }}>No matching categories found</p>;
                                                                }

                                                                return (
                                                                    <>
                                                                        <div ref={contentScrollRef} className={`p-relative ${classes.default_scroll} ${classes.content_scroll}`}>
                                                                            {!state.selected_sub_category ? (
                                                                                // LEVEL 2: Table of Sub-Category Names
                                                                                <div className={classes.configurations_container}>
                                                                                    <div className={classes.configurations_title}>
                                                                                        Configurations
                                                                                    </div>
                                                                                    <table className={classes.sub_category_table}>
                                                                                        <thead>
                                                                                            <tr>
                                                                                                <th className={classes.table_header_name}>NAME</th>
                                                                                                <th className={classes.table_header_desc}>DESCRIPTION</th>
                                                                                                <th className={classes.table_header_action}></th>
                                                                                            </tr>
                                                                                        </thead>
                                                                                        <tbody>
                                                                                            {(() => {
                                                                                                const query = state.search_query?.toLowerCase().trim();
                                                                                                const isUniqueSubCatMatch = query && filteredSubCategories.length === 1;

                                                                                                return filteredSubCategories.map((subCat, index) => {
                                                                                                    const isSubCatMatched = isUniqueSubCatMatch;
                                                                                                    return (
                                                                                                        <tr
                                                                                                            key={index}
                                                                                                            className={`${classes.sub_category_row} ${isSubCatMatched ? classes.pulseMatchedRow : ''}`}
                                                                                                            onClick={() => {
                                                                                                                setstate(prev => ({
                                                                                                                    ...prev,
                                                                                                                    selected_sub_category: subCat,
                                                                                                                    forward_sub_category: null
                                                                                                                }));
                                                                                                                lastAutoSelectedQueryRef.current = state.search_query; FetchSubCategoryFields(subCat.id);
                                                                                                            }}
                                                                                                        >
                                                                                                            <td className={classes.sub_category_cell_name}>
                                                                                                                {subCat.name}
                                                                                                            </td>
                                                                                                            <td className={classes.sub_category_cell_desc}>
                                                                                                                {subCat.description}
                                                                                                            </td>
                                                                                                            <td className={classes.sub_category_cell_action}>
                                                                                                                <i className={`ri-arrow-right-s-line ${classes.sub_category_row_icon}`}></i>
                                                                                                            </td>
                                                                                                        </tr>
                                                                                                    );
                                                                                                });
                                                                                            })()}
                                                                                        </tbody>
                                                                                    </table>
                                                                                </div>
                                                                            ) : (
                                                                                // LEVEL 3: Actual Configuration Page
                                                                                <div className={classes.fields_panel}>
                                                                                    {state.loading_sub_category ? (
                                                                                        <div className={classes.sub_category_loading_state}>
                                                                                            <div className={classes.field_skeleton}>
                                                                                                <GenericSkeleton count={8} height={45} />
                                                                                            </div>
                                                                                        </div>
                                                                                    ) : (
                                                                                        <>
                                                                                            {state.sub_category_fields && state.sub_category_fields.length > 0 ? (() => {
                                                                                                const query = state.search_query?.toLowerCase().trim();
                                                                                                const matchedFields = query ? state.sub_category_fields.filter(variable => variable.labels?.toLowerCase().includes(query)) : [];
                                                                                                const isUniqueFieldMatch = matchedFields.length === 1;

                                                                                                return state.sub_category_fields.map((variable, index) => {
                                                                                                    const isFieldMatched = isUniqueFieldMatch && variable.labels?.toLowerCase().includes(query);
                                                                                                    return (
                                                                                                        <div key={index} className={`${classes.field_row} ${isFieldMatched ? classes.pulseMatchedField : ''} ${variable.data_type === "json" ? classes.json_field_row : ''} ${variable.data_type === "multiple-select" ? "auto-complete-dropdown auto-complete-dropdown-42 auto-complete-dropdown-ticketing" : ''}`}>
                                                                                                            <Input
                                                                                                                type={variable.key == "LDAP_MANAGER_PASSWORD" || variable.key == "OKTA_CLIENT_SECRET" ? "password" : (variable.data_type === "boolean" || variable.data_type === "select") ? 'select' : variable.data_type === "json" ? "textarea" : variable.data_type === "checkbox" ? "checkbox" : variable.data_type === "multiple-select" ? "auto-complete-freesolo-v2" : variable.data_type === "password" ? "password" : "text"}
                                                                                                                mandatorySign={variable.required}
                                                                                                                name={variable.key}
                                                                                                                label={variable.labels}
                                                                                                                subHeading={"(" + variable.key + ")"}
                                                                                                                list={variable.data_type === "boolean" ? variable.possible_value ?
                                                                                                                    variable.possible_value.split(',').map(item => ({ id: item.trim(), label: item.trim() }))
                                                                                                                    : [{ id: 'true', label: 'true' }, { id: 'false', label: 'false' }]
                                                                                                                    : variable.data_type === "checkbox" || variable.data_type === "multiple-select" ? getBpVersioningList(variable.values_list) : variable.data_type === "select" ? variable.values_list : []
                                                                                                                }
                                                                                                                placeholder={variable.labels}
                                                                                                                disable={false}
                                                                                                                rows={variable.data_type === "json" ? 4 : null}
                                                                                                                count={variable.data_type === "multiple-select" ? 10 : null}
                                                                                                                onChangeHandler={variable.data_type === "integer" ? commonFunctions.onChangeHandlerNumber : variable.data_type === "checkbox" ? onChangeHandlerForKeyValue : variable.data_type === "multiple-select" ? onKeyValueChangeHandler : commonFunctions.onChangeHandler}
                                                                                                                data={state.data}
                                                                                                                error={state.error}
                                                                                                                info={variable?.description}
                                                                                                            />
                                                                                                        </div>
                                                                                                    );
                                                                                                });
                                                                                            })() : (
                                                                                                <p style={{ padding: '20px', color: '#888', fontSize: '12px', textAlign: 'center' }}>No matching categories found</p>
                                                                                            )}
                                                                                        </>
                                                                                    )}
                                                                                </div>
                                                                            )}
                                                                        </div>
                                                                    </>
                                                                );
                                                            })()
                                                }
                                                {(() => {
                                                    if (!state.selected_sub_category) return null;
                                                    if (state.loading_sub_category) return null;
                                                    const query = state.search_query?.toLowerCase().trim();
                                                    const hasMatchingFields = query
                                                        ? (state.sub_category_fields || []).some(variable => variable.labels?.toLowerCase().includes(query))
                                                        : (state.sub_category_fields || []).length > 0;

                                                    if (!hasMatchingFields) return null;

                                                    return (
                                                        <div className={`footer pd-10 text-right ${classes.action_footer}`}>
                                                            <button
                                                                onClick={() => { validateAndSaveData(state.selected_sub_category ? state.selected_sub_category.id : state.selected_tab, "force") }}
                                                                disabled={single_item.single_item_data_loading_force}
                                                                className={`${classes.action_button} ${classes.action_button_secondary} ${single_item.single_item_data_loading_force ? classes.disabled_action_button : ''}`}
                                                            >
                                                                {single_item.single_item_data_loading_force ? 'Applying...' : 'Apply Immediately'}
                                                            </button>
                                                            <button
                                                                onClick={() => { validateAndSaveData(state.selected_sub_category ? state.selected_sub_category.id : state.selected_tab) }}
                                                                disabled={single_item.single_item_data_loading_async}
                                                                className={`${classes.action_button} ${classes.action_button_primary} ${single_item.single_item_data_loading_async ? classes.disabled_action_button : ''}`}
                                                            >
                                                                {single_item.single_item_data_loading_async ? 'Applying...' : 'Apply Async'}
                                                            </button>
                                                        </div>
                                                    );
                                                })()}
                                            </div>

                                        </div>
                                        :
                                        <div className={`d-flex align-center justify-center ${classes.empty_state}`}>
                                            <div
                                                className={`text-center alert alert-primary border-style-dashed bg-white ${classes.empty_state_card}`}>
                                                <div className="text-box">
                                                    <p className="main-text  font-14"> No settings Configured</p>
                                                    <Link to={"/system-settings/add"}>
                                                        <button className="btn btn-primary">
                                                            Configure Settings
                                                        </button>
                                                    </Link>
                                                </div>
                                            </div>
                                        </div>
                    }
                </div>
            </div>
            {
                state.show_dialog &&
                <Dialog
                    open={state.show_dialog}
                    onClose={handleClickClose}
                    aria-labelledby="alert-dialog-title"
                    aria-describedby="alert-dialog-description"
                >
                    <div className={`d-flex align-center space-between ${classes.dialog_header}`}>
                        <div className="d-flex align-center">
                            <i className={`ri-information-line text-center ${classes.dialog_header_icon}`} />
                            <p className='font-12 ml-5 color-white'>Important Information</p>
                        </div>
                        <button className="btn btn-transparent" onClick={handleClickClose}>
                            <span className={`ri-close-line font-24 ${classes.dialog_close_icon}`}></span>
                        </button>
                    </div>
                    <div className="card ">

                        <div className="card-body d-flex">
                            <div className="m-auto">
                                <div className={classes.dialog_feature_header}>
                                    {/* <div className={classes.dialog_feature_icon_wrap}>

                            </div> */}
                                    <i className={`ri-flashlight-line text-center ${classes.dialog_feature_icon}`}></i>
                                    <p className={classes.dialog_feature_title}>Hyperbuild is a premium feature of BuildPiper</p>
                                </div>

                                <div className={classes.dialog_body_text}>

                                    <p className="font-12 text-center mb-5">
                                        This is a premium feature and not part of the current subscription. However you are eligible for a free trial till December 2023.
                                    </p>


                                </div>
                            </div>
                        </div>
                        <div className="card-footer border-top pd-10 space-between d-flex align-center">
                            <button className="btn btn-outline-dark-grey" onClick={handleClickClose}>
                                Cancel
                            </button>

                            <div className=''>
                                <Button className='btn  btn-primary' onClick={() => { validateAndSaveData(state.selected_sub_category ? state.selected_sub_category.id : state.selected_tab, "force") }} isLoading={single_item.single_item_data_loading_force}>Apply immediately</Button>
                                <Button className='btn  btn-primary' onClick={() => { validateAndSaveData(state.selected_sub_category ? state.selected_sub_category.id : state.selected_tab) }} isLoading={single_item.single_item_data_loading_async}>Apply Async</Button>
                            </div>
                            {/* <Link className="btn btn-primary-v2" >
                      Confirm
                    </Link> */}
                        </div>
                    </div>
                </Dialog>
            }
        </div>
    )
}

