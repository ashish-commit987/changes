        response.forEach(variable => {
            if (variable.data_type === "multiple-select") {
                question_arr[variable.key] = safeParseMultipleSelect(variable.value);
            } else {
                question_arr[variable.key] = (variable.value !== undefined && variable.value !== null) ? variable.value : (variable.data_type === "boolean" ? "false" : "");
            }

            if (variable.required) {
                validations_arr[variable.key] = [VALIDATION_TYPE_REQUIRED];
            }
        });

        setstate(prev => ({
            ...prev,
            loading_sub_category: false,
            sub_category_fields: response,
            data: question_arr,
            validations: validations_arr
        }));
    }

