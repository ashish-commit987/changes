                                                <div className={`${classes.skeleton_radius} ${classes.no_flex}`}>
                                                    <GenericSkeleton
                                                        width="380px"
                                                        height={6}
                                                    />
                                                </div>
                                            </div>

                                        </div>

                                    ))}

                                </div>


                            </div>
                            :
                            state.error_msg ?
                                <ErrorComponent error={state.error_msg} />
                                :
                                single_item.task_id ?
                                    <StepProgressDetailed
                                        task_id={single_item.task_id}
                                        placeholders={{}}
                                        refresh={refreshState}
                                        variant="SAME_PAGE_REDIRECT" />
