    function getCurrentCustomTagPattern(list) {
        let arr = [];

        try {
            // Case 1: It's already an array
            if (Array.isArray(list)) {
                arr = list.map(item => (typeof item === 'string' ? item : item?.id || ""));
            } else {
                // Case 2: It's a JSON string of an array
                const parsed = JSON.parse(list || '[]');
                arr = Array.isArray(parsed)
                    ? parsed.map(item => (typeof item === 'string' ? item : item?.id || ""))
                    : [];
            }
        } catch (err) {
            console.error("Invalid input to getCurrentCustomTagPattern:", list, err);
            return "";
        }

        // Build the pattern preview string from examples
        return arr
            .map((item) => {
                const match = input_values_list.find(entry => entry.type === item);
                return match ? match.example : item;
            })
            .join("-");
    }

