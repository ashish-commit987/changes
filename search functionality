    function validateAndSaveData(id, url) {

        var result = ValidateDataSet(state.data, state.validations);
        if (url) {
            var post_url = GenerateURL({ id: id }, properties.api.force_update_system_settings + "?force_update=true");
        } else {
            var post_url = GenerateURL({ id: id }, properties.api.force_update_system_settings + "?force_update=false");
        }

        if (result.valid) {
            var basic_details = {};
            basic_details = { ...state.data }
            var keys_arr = Object.keys(basic_details);
            const fieldsToUpdate = state.sub_category_fields;
            fieldsToUpdate.forEach((element, index) => {
                console.log(element, "ascbhbchsdh")
                if (keys_arr.includes(element.key)) {
                    const val = basic_details[element.key];
                    if (element.data_type === "multiple-select") {
                        try {
                            element.value = JSON.stringify(val || []);
                        } catch (e) {
                            element.value = "[]";
                        }
                    } else {
                        element.value = val;
                    }
                }


            });
            console.log(fieldsToUpdate, "fieldsToUpdate")
            showSnackbar("info", "Applying changes...")
            PostData(post_url, fieldsToUpdate, onSaveSuccess, onSaveFail);
            set_single_item(new_state => ({
                ...new_state,
                single_item_data_loading_force: url ? true : false,
                single_item_data_loading_async: !url ? true : false,
            }))
            handleClickClose();
        } else {
            let error_msg = showErrorHandlerUpdated({ ...result.error })
            showSnackbar("error", "Unable to apply changes", error_msg)
            setstate(new_state => ({
                ...new_state,
                error: {
                    ...new_state.error,
                    ...result.error
                },

            }));
        }
    }
