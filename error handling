// 13. Update onUpdateHandle with comprehensive error handling
const onUpdateHandle = (uniqueId, updatedList) => {
  try {
    const safeUpdatedList = safeArray(updatedList);
    let updatedKey = "";

    if (uniqueId === "more-button-adv-0") {
      addFiltersToUrl("adv_search", safeUpdatedList);
      if (safeUpdatedList.length === 0) {
        resetAdvFilter();
      } else {
        setState((prevState) => ({
          ...prevState,
          moreAdvFilterList: safeUpdatedList,
        }));
      }
    } else {
      // Map unique IDs to filter keys
      const idToKeyMap = {
        "vm_name_adv_1": "vm_name",
        "primary_tag_adv_2": "primary_tag",
        "secondary_tag_adv_3": "secondary_tag",
        "ip_address_adv_4": "ip_address",
        "status_adv_5": "status",
      };

      updatedKey = idToKeyMap[uniqueId];
      
      if (!updatedKey) {
        console.warn(`Unknown filter ID: ${uniqueId}`);
        return;
      }

      setState((prevState) => ({
        ...prevState,
        advFilters: {
          ...prevState.advFilters,
          [updatedKey]: safeUpdatedList,
        },
      }));

      addFiltersToUrl(updatedKey, safeUpdatedList);
      const advFilters = { 
        ...state.advFilters, 
        [updatedKey]: safeUpdatedList 
      };
      
      if (id) {
        fetchVMsWithFilters(id, 1, advFilters);
      }
    }
  } catch (error) {
    console.error("Error updating filters:", error);
    showSnackbar("Error updating filters", "error");
  }
};

// 14. Update addFiltersToUrl with safe operations
const addFiltersToUrl = (filterName, filterValue) => {
  try {
    let urlSearchParams = new URLSearchParams(location.search);
    const allFilters = [
      "vm_name",
      "primary_tag",
      "secondary_tag",
      "ip_address",
      "status",
    ];

    if (filterName === "all_delete") {
      urlSearchParams = new URLSearchParams();
    } else {
      const safeFilterValue = safeArray(filterValue);
      
      if (filterName === "adv_search") {
        allFilters.forEach((value) => {
          if (!safeFilterValue.includes(value)) {
            urlSearchParams.delete(value);
          }
        });
      }

      if (safeFilterValue.length === 0) {
        urlSearchParams.delete(filterName);
      } else {
        const valueString = safeFilterValue.join(",");
        if (urlSearchParams.has(filterName)) {
          urlSearchParams.set(filterName, valueString);
        } else {
          urlSearchParams.append(filterName, valueString);
        }
      }
    }

    history({
      pathname: location.pathname,
      search: urlSearchParams.toString(),
    });
  } catch (error) {
    console.error("Error updating URL filters:", error);
  }
};

