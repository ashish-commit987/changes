const TicketList = (props) => {
   const { showSnackbar } = useCustomSnackbar();
  const classes = useStyles();
  const data = props.data ? props.data : {};
  const [state, setState] = useState({ loading_status: false });
  const refreshFun = props.refreshFun ? props.refreshFun : () => { }
  const refreshForDel = props.refreshForDel ? props.refreshForDel : () => {}
  const handleClickOpenDialogEdit = props.handleClickOpenDialogEdit ? props.handleClickOpenDialogEdit : () => { };

  const TestConnection = (id) => {
    const post_data = {
      integration_id: id
    };
    const integrationLabel = INTEGRATION_TYPE_MAP[data.integration_type] || "integration";
    showSnackbar('info', `Testing connection with ${integrationLabel}...`);
    PostData(GenerateURL({}, properties.api.integration_test), post_data, onFetchSuccess, onFetchFail);
    setState(new_state => ({
      ...new_state,
      loading_status: true
    }));
  }

  function onFetchSuccess(response) {
    const integrationLabel = INTEGRATION_TYPE_MAP[data.integration_type] || "integration";
    showSnackbar('success', `Connection established with ${integrationLabel}.`);
    refreshFun()
    setState(new_state => ({
      ...new_state,
      loading_status: false,
      jira_users: [
        ...response.users
      ],
    }));
  }

  function onFetchFail(error) {
    const integrationLabel = INTEGRATION_TYPE_MAP[data.integration_type] || "integration";
    var error_msg = showErrorHandlerUpdated(error);
    showSnackbar('error', `Unable to test connection with ${integrationLabel}.`, error_msg);
    console.log("Error:", error_msg);
    refreshFun()
    setState(new_state => ({
      ...new_state,
      loading_status: false
    }));
  }

  return (
    <div className={classes.commonTable}>
      <div className={classes.iconContainer}>
        <div className={classes.iconWrapper}>
          {data.integration_type === "jira" ? (
            <img src={"/images/logos/jira_icon.svg"} style={{ width: '80%' }} alt="Jira" />
          ) : data.integration_type === "azure_devops" ? (
            <img src={"/images/logos/azure_devops.svg"} style={{ width: '80%' }} alt="Azure DevOps" />
          ) : data.integration_type === "service_now" ? (
            <img src={"/images/logos/sevice_now.svg"} style={{ width: '80%' }} alt="ServiceNow" />
          ) : null}
        </div>
        <Tooltip title={data.integration_name ? data.integration_name : "N/A"}>
          <p className={classes.textEllipsis} style={{ marginLeft: 'var(--space-5)' }}>
            {data.integration_name ? data.integration_name : "N/A"}
          </p>
        </Tooltip>
      </div>

      <div>
        {data.credential_id && data.credential_id.name ? (
          <Tooltip title={data.credential_id.name}>
            <p className={classes.textEllipsis}>{data.credential_id.name}</p>
          </Tooltip>
        ) : (
          <p className={classes.textEllipsis}>N/A</p>
        )}
      </div>

      <div>
        {data.server_url && data.server_url ? (
          <Tooltip title={data.server_url}>
            <p className={classes.textEllipsis}>{data.server_url}</p>
          </Tooltip>
        ) : (
          <p className={classes.textEllipsis}>N/A</p>
        )}
      </div>

      <div className={classes.statusContainer}>
        <div style={{ width: 'var(--space-160)' }}>
        {data.status && data.status === "CONNECTED" ? (
          <Chip
            label="Connected"
            variant="connected"
              className={classes.statusChip}
            icon={<span style={{ lineHeight: '12px' }} className='ri-checkbox-circle-line font-16'></span>}
          />
        ) : (
          <Chip
            label="Not Connected"
            variant="disconnected"
              className={classes.statusChip}
            icon={<span style={{ lineHeight: '12px' }} className='ri-close-circle-line font-16'></span>}
          />
        )}
        </div>
        <Button
          variant='outline'
          size='sm'
          className={`btn btn-outline-primary btn-sm ${classes.testButton}`}
          onClick={() => { TestConnection(data.id) }}
          isLoading={state.loading_status}
        >
          Test
        </Button>
      </div>

      <div className={classes.actionsContainer}>
        <OptionList
          data={{ id: data.id, integration_type: data.integration_type }}
          handleClickOpenDialogEdit={handleClickOpenDialogEdit}
          refreshFun={refreshFun}
          refreshForDel={refreshForDel}
        />
      </div>
    </div>
  )
}

