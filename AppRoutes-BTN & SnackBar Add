                  <Route
                    path="/golden-ami/list"
                    element={
                      <RouteWithLayout
                        layout={MainLayout}
                        component={GoldenAmiList}
                      />
                    }
                  />
                </>
              ) : (
                <Route component={ErrorPage} />
              )}

              <Route element={ErrorPage} />
            </>
          ) : (
            <Route
              element={
                <Navigate
                  to={{
                    pathname: redirectTo,
                    state: { prevLocation: location },
                  }}
                />
              }
            />
          )}
        </Routes>
      </>
    );
}

export default AppRoutes
