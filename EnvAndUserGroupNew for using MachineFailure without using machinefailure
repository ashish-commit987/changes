import React from "react";
import PropTypes from 'prop-types';
import Dialog from '@mui/material/Dialog';
import { makeStyles } from '@mui/styles';
import NewChip from "../../../components/newChip/NewChip";
import { Link } from 'react-router-dom';
import { Loading } from '../../utils/Loading';

const EnvAndUserGroupNew = (props) => {
    const classes = useStyles();
    const {
        open,
        handleClose,
        executionData = [],
        headerTitle = "Execution details",
        envName = "Env",
        showTable = true,
        isRollbackConfirmation = false,
        onContinue,
        onRerun,
        onRollback,
        onBack,
        onConfirm,
        canContinue = false,
        canRollback = false,
        canRerun = false,
        loading = false,
        error = null,
        failedStageName = null,
        failedTaskName = null
    } = props;

    // Helper to determine status chip properties
    const getStatusChipProps = (status) => {
        if (status === 'FAILED') {
            return { label: 'Failed', variant: 'error' };
        } else if (status === 'DONT_RUN') {
            return { label: "DIDN'T RUN", variant: 'light' };
        } else if (status === 'SUCCESS') {
            return { label: 'Success', variant: 'success' };
        } else {
            return { label: status || 'N/A', variant: 'light' };
        }
    };

    return (
        <Dialog
            fullWidth={true}
            maxWidth={'md'}
            open={open}
            onClose={handleClose}
            className={`${classes.root} dialog-align-corner`}
            aria-labelledby="max-width-dialog-title"
        >
            <div className='d-grid ml-auto dialog-sub-component' style={{ gridTemplateColumns: '396px 650px' }}>
                <div className={'left-panel-dialog-down'}>
                </div>
                <div className='right-panel-dialog bg-white'>
                    {loading ? (
                        <div className="pd-20">
                            <Loading varient="light" />
                        </div>
                    ) : error ? (
                        <div className='pd-20 text-center mt-20 mb-20' style={{ backgroundColor: '#F8F8F8', borderRadius: '8px', margin: '20px' }}>
                            <i className="ri-error-warning-line text-center" style={{ color: '#e9797e', textAlign: 'center', fontSize: '40px' }}></i>
                            <p className="font-12 text-center">
                                {typeof (error) == "string" ? error : error.toString()}
                            </p>
                            <p className="font-12 text-center">Something went wrong. please contact to the Super Admin</p>
                        </div>
                    ) : (
                        <>
                            <div className='font-18 font-weight-600 color-white d-flex align-center space-between' style={{ backgroundColor: '#0086ff', padding: '13.5px 20px' }}>
                                <p>Manage Failure</p>

                                <button
                                    className='btn float-cancel-button'
                                    style={{ left: '396px' }}
                                    onClick={handleClose}
                                >
                                    <span className='ri-close-line'></span>
                                </button>
                            </div>
                            <div className='d-flex align-center space-between' style={{ padding: '20px 20px' }}>
                                <p>
                                    {failedStageName
                                        ? `Stage has failed with following details : ${failedStageName}`
                                        : `Job has failed with following details : ${failedTaskName || "N/A"}`}
                                </p>
                            </div>

                            {/* Table Section or Confirmation Section */}
                            {showTable ? (
                                <div className="body-panel-new-one" style={{ padding: '0 16px 16px 20px' }}>
                                    {executionData && executionData.length > 0 ? (
                                        <>
                                            <div className={classes.tableContainer}>
                                                <div className={classes.tableHeader}>

                                                    <span className={classes.headerTitle}>
                                                        {headerTitle}
                                                    </span>
                                                    <span className={classes.stagingBadge}>
                                                        <NewChip
                                                            label={envName}
                                                            variant={"highlight2"}
                                                            shape="standard"
                                                        />
                                                    </span>

                                                </div>

                                                <table className={classes.table}>
                                                    <thead>
                                                        <tr>
                                                            <th>Service</th>
                                                            <th>Status</th>
                                                            <th>Reason / Logs</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {executionData.map((row, index) => {
                                                            const statusProps = getStatusChipProps(row.status);
                                                            const displayName = row.service_name || row.task_type || row.operation || "N/A";
                                                            return (
                                                                <tr key={index}>
                                                                    <td>{displayName}</td>
                                                                    <td>
                                                                        <NewChip
                                                                            label={statusProps.label}
                                                                            variant={statusProps.variant}
                                                                            shape="standard"
                                                                        />
                                                                    </td>
                                                                    <td>
                                                                        {row.manage_failure_json && row.manage_failure_json.conflict_meta_data ? (
                                                                            <>
                                                                                <div>Canary is Already Running</div>
                                                                                <div>
                                                                                    Via Pipeline:{" "}
                                                                                    <Link
                                                                                        to={`/application/${row.manage_failure_json.conflict_meta_data.project_id}/pipeline/${row.manage_failure_json.conflict_meta_data.pipeline_id}/execution/${row.manage_failure_json.conflict_meta_data.pipeline_instance_id}`}
                                                                                        target="_blank"
                                                                                        className="text-anchor-blue"
                                                                                    >
                                                                                        {row.manage_failure_json.conflict_meta_data.pipeline_name}
                                                                                    </Link>
                                                                                </div>
                                                                            </>
                                                                        ) : row.logs_url ? (
                                                                            <Link to={`/logs?global_task_id=${row.logs_url}`} target="_blank" className='text-anchor-blue '>View Logs</Link>
                                                                        ) : row.reason ? row.reason : '-'}
                                                                    </td>
                                                                </tr>
                                                            )
                                                        })}
                                                    </tbody>
                                                </table>
                                            </div>
                                            <div>
                                                <div className={classes.noteContainer}>
                                                    <div className={classes.noteHeader}>
                                                        <span className="ri-information-line font-24"></span>
                                                        <span className={classes.noteTitle}>PLEASE NOTE</span>
                                                    </div>

                                                    <div className={classes.noteBody}>
                                                        <p>
                                                            On pipeline failure, there are three ways of recovering from failure.
                                                        </p>

                                                        <ol>
                                                            <li>Re-run the failed job</li>
                                                            <li>Continue to next job with failure</li>
                                                            <li>Complete Rollback to baseline</li>
                                                        </ol>
                                                    </div>
                                                </div>

                                            </div>
                                        </>
                                    ) : (
                                        <div className="text-center font-16 color-icon-secondary">No Data Found</div>
                                    )}

                                    <div className='footer-right-panel d-flex align-center justify-end' style={{ gap: '12px' }}>
                                        {canContinue && (
                                            <button className='btn btn-outlined d-flex align-center justify-center btn-semi-bold' style={{ color: '#124D9B' }} onClick={onContinue}>CONTINUE WITH FAILURE</button>
                                        )}
                                        {canRollback && (
                                            <button className='btn btn-secondary d-flex align-center justify-center btn-semi-bold' style={{ backgroundColor: '#FEA111' }} onClick={onRollback}>COMPLETE ROLLBACK</button>
                                        )}
                                        {canRerun && (
                                            <button className='btn btn-primary d-flex align-center justify-center btn-semi-bold' onClick={onRerun}>RE-RUN JOB</button>
                                        )}

                                    </div>
                                </div>
                            ) : (
                                // Confirmation View
                                <div className="body-panel-new-one" style={{ padding: '0 16px 16px 20px' }}>
                                    <div className={classes.noteContainer} style={{ marginTop: '20px', marginBottom: '20px' }}>
                                        <div className={classes.noteHeader}>
                                            <span className="ri-information-line font-24"></span>
                                            <span className={classes.noteTitle}>CONFIRM ACTION</span>
                                        </div>
                                        <div className={classes.noteBody}>
                                            <p>
                                                {isRollbackConfirmation
                                                    ? "Are you sure you want to rollback all services to baseline?"
                                                    : "Are you sure you want to continue with failures? The pipeline will skip failed microservices."}
                                            </p>
                                        </div>
                                    </div>
                                    <div className='footer-right-panel d-flex align-center justify-end' style={{ gap: '12px' }}>
                                        <button className='btn btn-outlined d-flex align-center justify-center btn-semi-bold' onClick={onBack}>
                                            BACK
                                        </button>
                                        <button className='btn btn-primary d-flex align-center justify-center btn-semi-bold' onClick={onConfirm}>
                                            CONFIRM
                                        </button>
                                    </div>
                                </div>
                            )}
                        </>
                    )}
                </div>
            </div>
        </Dialog>
    );
};

EnvAndUserGroupNew.propTypes = {
    open: PropTypes.bool,
    handleClose: PropTypes.func,
    executionData: PropTypes.array,
    headerTitle: PropTypes.string,
    envName: PropTypes.string,
    showTable: PropTypes.bool,
    isRollbackConfirmation: PropTypes.bool,
    onContinue: PropTypes.func,
    onRerun: PropTypes.func,
    onRollback: PropTypes.func,
    onBack: PropTypes.func,
    onConfirm: PropTypes.func,
    canContinue: PropTypes.bool,
    canRollback: PropTypes.bool,
    canRerun: PropTypes.bool,
    loading: PropTypes.bool,
    error: PropTypes.any,
    failedStageName: PropTypes.string,
    failedTaskName: PropTypes.string
}

export default EnvAndUserGroupNew;

